//@version=6
strategy(
     title="ICT Institutional Multi-Timeframe Strategy [Clean Signals & Exact Levels]",
     shorttitle="ICT-MTF-Clean",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.cash,
     default_qty_value=10000,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.00005,
     calc_on_every_tick=false,
     calc_on_order_fills=false,
     process_orders_on_close=true
     )

// =============================================================================
// ARCHITECTURE SPECIFICATION: INSTITUTIONAL ICT MULTI-TIMEFRAME CONFLUENCE
// =============================================================================
// 1. MACRO BIAS (Daily D1): EMA 50 trend alignment filter.
// 2. HIGHER TIMEFRAME SETUP (1-Hour 1H):
//    - Institutional Displacement: Donchian 48 breakout with strong candle body (>=55%).
//    - Volume Expansion: 1H Volume must be above 20-period Volume SMA (>1.1x) to
//      confirm real institutional order flow (eliminates low-liquidity false moves).
//    - Anti-Exhaustion Protection: 1H RSI must NOT be oversold (RSI >= 35) for Shorts
//      and NOT overbought (RSI <= 65) for Longs. Prevents selling the bottom!
// 3. LOWER TIMEFRAME REFINEMENT (15-Minute Execution Chart):
//    - Does NOT chase breakout extremes! Enters Retracement Hunting mode.
//    - Waits for price to retrace into the 50% Equilibrium / Order Block / 15m FVG zone.
//    - Confirms rejection on 15m with volume before pulling the trigger.
// 4. CLEAN PROFESSIONAL CHART DISPLAY:
//    - All details (Entry, SL, TP, Pips, R:R, Lots) placed DIRECTLY ON THE SIGNAL LABEL.
//    - No cluttering box at the top right!
//    - Clear lines connect Entry, Stop Loss, and Take Profit across the trade duration.
//    - Historical trades cleanly preserved with outcome tags (🎯 TP HIT / 🛑 SL HIT).
// 5. STRICT 1-TRADE LOCK & STRUCTURAL COOLDOWN:
//    - Exactly ONE trade active at a time. Zero signals can trigger while in a trade.
//    - Mandatory cooldown period after trade exit prevents revenge/exhaustion re-entries.
// =============================================================================

// =============================================================================
// INPUT PARAMETERS
// =============================================================================
// 1. Trade & Risk Settings
grp_risk = "Institutional Risk & Execution Model"
risk_pct           = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=grp_risk)
account_size_input = input.float(10000.0, "Account Size (USD)", minval=100.0, step=1000.0, group=grp_risk)
use_compounding    = input.bool(true, "Compound Live Equity", group=grp_risk)
rr_ratio           = input.float(2.0, "Target Risk/Reward Ratio", minval=1.2, maxval=5.0, step=0.25, group=grp_risk)
sl_atr_buffer      = input.float(0.15, "Stop Loss ATR Buffer Multiple", minval=0.05, maxval=0.50, step=0.05, group=grp_risk)
cooldown_bars      = input.int(16, "Post-Trade Cooldown (15m Bars = 4 Hours)", minval=4, maxval=60, group=grp_risk)
max_trade_bars     = input.int(120, "Trade Invalidation Timeout (Bars)", minval=20, maxval=400, group=grp_risk)
max_hunting_bars   = input.int(24, "Max Retracement Wait (15m Bars = 6 Hours)", minval=8, maxval=60, group=grp_risk)

// 2. Higher Timeframe (1H & Daily) Setup Parameters
grp_htf = "Higher Timeframe (1H & Daily) Alignment"
sig_tf             = input.timeframe("60", "Signal Anchor Timeframe", group=grp_htf)
donchian_len       = input.int(48, "1H Breakout Lookback (48 bars = 2 Days)", minval=10, maxval=120, group=grp_htf)
htf_ema_len        = input.int(200, "1H Trend Filter EMA Length", minval=50, maxval=500, group=grp_htf)
use_d1_filter      = input.bool(true, "Require Daily (D1) EMA 50 Alignment", group=grp_htf)
d1_ema_len         = input.int(50, "Daily Macro EMA Length", minval=20, maxval=200, group=grp_htf)
min_body_ratio     = input.float(0.55, "1H Minimum Candle Body Ratio (Anti-Wick)", minval=0.40, maxval=0.95, step=0.05, group=grp_htf)

// 3. Volume & Exhaustion Filters
grp_vol = "Volume & Anti-Exhaustion Filters"
use_volume_filter  = input.bool(true, "Require Institutional Volume Expansion (>1.1x MA)", group=grp_vol)
vol_ma_len         = input.int(20, "Volume Moving Average Length", minval=5, maxval=50, group=grp_vol)
vol_multiplier     = input.float(1.10, "Volume Multiplier vs Average", minval=1.0, maxval=2.5, step=0.05, group=grp_vol)
rsi_len            = input.int(14, "RSI Length", minval=5, maxval=50, group=grp_vol)
adx_len            = input.int(14, "ADX Length", minval=5, maxval=50, group=grp_vol)
adx_min            = input.float(20.0, "ADX Minimum Trend Threshold", minval=10.0, maxval=35.0, group=grp_vol)

// 4. Session & Webhook
grp_session = "Session & Webhook Credentials"
session_filter_enabled = input.bool(true, "Enable London/NY Session Filter (UTC)", group=grp_session)
allowed_session        = input.session("0700-1700", "Allowed Session Window (UTC)", group=grp_session)
webhook_secret         = input.string("test-secret-key-12345", "Webhook Secret Key", group=grp_session)
env_label              = input.string("LIVE", "Environment (LIVE or TEST)", options=["LIVE", "TEST"], group=grp_session)

// =============================================================================
// DAILY (D1) MACRO TREND ENGINE - NON-REPAINTING
// =============================================================================
f_calc_d1() =>
    [close, ta.ema(close, d1_ema_len)]

[d1_c_raw, d1_ema_raw] = request.security(
     syminfo.tickerid,
     "D",
     f_calc_d1(),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
     )

d1_bullish = not use_d1_filter or (d1_c_raw[1] > d1_ema_raw[1])
d1_bearish = not use_d1_filter or (d1_c_raw[1] < d1_ema_raw[1])

// =============================================================================
// 1-HOUR (60m) SETUP ENGINE - WITH VOLUME & EXHAUSTION PROTECTION
// =============================================================================
f_calculate_1h_state() =>
    c = close
    h = high
    l = low
    o = open
    v = volume

    ema200 = ta.ema(c, htf_ema_len)
    ema20  = ta.ema(c, 20)
    ema50  = ta.ema(c, 50)
    d_high = ta.highest(h[1], donchian_len)
    d_low  = ta.lowest(l[1], donchian_len)

    cross_long  = ta.crossover(c, d_high)
    cross_short = ta.crossunder(c, d_low)

    v_ma = ta.sma(v, vol_ma_len)
    vol_ok = not use_volume_filter or (v >= v_ma * vol_multiplier) or (v == 0)

    [di_p, di_m, adx_val] = ta.dmi(adx_len, adx_len)
    adx_rising = adx_val > adx_val[1]
    rsi_val = ta.rsi(c, rsi_len)
    atr_val = ta.atr(14)

    rsi_short_healthy = rsi_val >= 35.0 and rsi_val <= 50.0
    rsi_long_healthy  = rsi_val >= 50.0 and rsi_val <= 65.0

    rng = h - l
    body_ratio_long  = rng > 0 ? (c - l) / rng : 0.5
    body_ratio_short = rng > 0 ? (h - c) / rng : 0.5

    cond_long  = cross_long  and (c > ema200) and (ema20 > ema50) and (adx_val >= adx_min) and adx_rising and rsi_long_healthy  and vol_ok and (body_ratio_long >= min_body_ratio)
    cond_short = cross_short and (c < ema200) and (ema20 < ema50) and (adx_val >= adx_min) and adx_rising and rsi_short_healthy and vol_ok and (body_ratio_short >= min_body_ratio)

    var float ob_hl = na
    var float ob_ll = na
    ob_hl := h[1]
    ob_ll := l[1]
    for k = 1 to 5
        if c[k] < o[k]
            ob_hl := h[k]
            ob_ll := l[k]
            break

    var float ob_hs = na
    var float ob_ls = na
    ob_hs := h[1]
    ob_ls := l[1]
    for k = 1 to 5
        if c[k] > o[k]
            ob_hs := h[k]
            ob_ls := l[k]
            break

    [cond_long, cond_short, c, d_high, d_low, atr_val, ob_hl, ob_ll, ob_hs, ob_ls, h, l, adx_val, rsi_val]

[raw_long, raw_short, raw_c, raw_dh, raw_dl, raw_atr, raw_ob_hl, raw_ob_ll, raw_ob_hs, raw_ob_ls, raw_h, raw_l, raw_adx, raw_rsi] = request.security(
     syminfo.tickerid,
     sig_tf,
     f_calculate_1h_state(),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
     )

h1_long_setup  = raw_long[1] and d1_bullish
h1_short_setup = raw_short[1] and d1_bearish
h1_atr_confirmed = raw_atr[1]
h1_adx_confirmed = raw_adx[1]
h1_rsi_confirmed = raw_rsi[1]
h1_ob_hl_confirmed = raw_ob_hl[1]
h1_ob_ll_confirmed = raw_ob_ll[1]
h1_ob_hs_confirmed = raw_ob_hs[1]
h1_ob_ls_confirmed = raw_ob_ls[1]
h1_high_confirmed = raw_h[1]
h1_low_confirmed  = raw_l[1]

is_sub_1h = timeframe.isintraday and timeframe.multiplier < 60
is_new_1h_bar = ta.change(time(sig_tf)) != 0
h1_pulse = is_sub_1h ? is_new_1h_bar : barstate.isconfirmed

in_session = not session_filter_enabled or not na(time(timeframe.period, allowed_session + ":1234567"))

ltf_fvg_bearish = high < low[2]
ltf_fvg_bear_bottom = high
ltf_fvg_bullish = low > high[2]
ltf_fvg_bull_top = low

// =============================================================================
// STRICT 1-TRADE STATE MACHINE WITH STRUCTURAL COOLDOWN
// =============================================================================
var int active_trade_state = 0
var int setup_hunting = 0
var int hunting_start_bar = na
var int trade_entry_bar = na
var int last_trade_exit_bar = -999

var float hunt_ob_h = na
var float hunt_ob_l = na
var float hunt_fib_50 = na
var float hunt_atr = na

var float entry_price = na
var float structural_sl = na
var float target_tp = na
var float suggested_lots = na

var box   live_ob_box = na
var line  live_entry_line = na
var line  live_sl_line = na
var line  live_tp_line = na

is_gold = str.contains(syminfo.ticker, "XAU")
is_jpy = str.contains(syminfo.ticker, "JPY")
is_usd_base = (str.startswith(syminfo.ticker, "USD") or str.contains(syminfo.ticker, ":USD")) and not is_gold
is_gold_or_jpy = is_gold or is_jpy
p_fmt = is_gold_or_jpy ? "#.##" : "#.#####"
pip_unit = is_gold_or_jpy ? 0.01 : 0.0001

current_capital = use_compounding ? math.max(strategy.equity, account_size_input * 0.5) : account_size_input
risk_cash = current_capital * (risk_pct / 100.0)

f_calc_units(sl_dist) =>
    units = 1000.0
    if sl_dist > 0
        if is_gold
            units := risk_cash / sl_dist
        else if is_jpy or is_usd_base
            units := (risk_cash * close) / sl_dist
        else
            units := risk_cash / sl_dist
    units

// =============================================================================
// STEP 1: INITIATE SETUP HUNTING (1H DISPLACEMENT OCCURS)
// =============================================================================
can_hunt = (active_trade_state == 0) and (setup_hunting == 0) and in_session and h1_pulse and ((bar_index - last_trade_exit_bar) >= cooldown_bars) and (strategy.position_size == 0)

if can_hunt
    if h1_short_setup
        setup_hunting := -1
        hunting_start_bar := bar_index
        hunt_ob_h := h1_ob_hs_confirmed
        hunt_ob_l := h1_ob_ls_confirmed
        hunt_atr  := h1_atr_confirmed
        swing_h = hunt_ob_h
        swing_l = h1_low_confirmed
        hunt_fib_50 := swing_l + (0.50 * (swing_h - swing_l))

    else if h1_long_setup
        setup_hunting := 1
        hunting_start_bar := bar_index
        hunt_ob_h := h1_ob_hl_confirmed
        hunt_ob_l := h1_ob_ll_confirmed
        hunt_atr  := h1_atr_confirmed
        swing_l = hunt_ob_l
        swing_h = h1_high_confirmed
        hunt_fib_50 := swing_h - (0.50 * (swing_h - swing_l))

if (setup_hunting != 0) and ((bar_index - hunting_start_bar) > max_hunting_bars)
    setup_hunting := 0

// =============================================================================
// STEP 2: LOWER TIMEFRAME (15m) ENTRY REFINEMENT & CONFIRMATION
// =============================================================================
sig_long_fired = false
sig_short_fired = false

ltf_vol_ok = volume >= (ta.sma(volume, 14) * 0.85) or (volume == 0)

if (active_trade_state == 0) and (setup_hunting == -1) and in_session and (strategy.position_size == 0)
    retrace_into_premium = (high >= hunt_fib_50) or (high >= hunt_ob_l) or (ltf_fvg_bearish and high >= ltf_fvg_bear_bottom)
    rejection_confirmed = (close < open) and (close < low[1]) and ltf_vol_ok

    if retrace_into_premium and rejection_confirmed
        active_trade_state := -1
        setup_hunting := 0
        trade_entry_bar := bar_index
        sig_short_fired := true

        entry_price := close
        structural_sl := math.max(hunt_ob_h, high[1]) + (hunt_atr * sl_atr_buffer)
        risk_dist = structural_sl - entry_price
        target_tp := entry_price - (risk_dist * rr_ratio)

        sl_distance = math.abs(structural_sl - entry_price)
        trade_units = f_calc_units(sl_distance)
        suggested_lots := is_gold ? math.max(0.01, math.round(trade_units / 100.0, 2)) : math.max(0.01, math.round(trade_units / 100000.0, 2))

        strategy.entry("15m-Short", strategy.short, qty=trade_units)
        strategy.exit("Exit-Short", from_entry="15m-Short", stop=structural_sl, limit=target_tp)

        pips_sl = math.abs(structural_sl - entry_price) / pip_unit
        pips_tp = math.abs(entry_price - target_tp) / pip_unit
        calc_rr = math.round(pips_tp / math.max(pips_sl, 0.1), 1)

        lbl_text = "▼ SELL @" + str.tostring(entry_price, p_fmt) + "\n" +
                   "SL: " + str.tostring(structural_sl, p_fmt) + " (-" + str.tostring(pips_sl, "#.#") + " p)\n" +
                   "TP: " + str.tostring(target_tp, p_fmt) + " (+" + str.tostring(pips_tp, "#.#") + " p | 1:" + str.tostring(calc_rr, "#.#") + ")\n" +
                   "Lots: " + str.tostring(suggested_lots, "#.##")

        label.new(bar_index, high + (pip_unit * 12), text=lbl_text, style=label.style_label_down, color=color.new(#9f1239, 0), textcolor=color.white, size=size.normal)

        live_ob_box := box.new(
             left=bar_index - 8,
             top=hunt_ob_h,
             right=bar_index + 8,
             bottom=hunt_ob_l,
             border_color=color.new(#ef4444, 20),
             border_width=1,
             bgcolor=color.new(#ef4444, 88),
             text="-OB Supply [" + str.tostring(hunt_ob_l, p_fmt) + " - " + str.tostring(hunt_ob_h, p_fmt) + "]",
             text_color=color.new(#ef4444, 0),
             text_size=size.small
             )

        live_entry_line := line.new(bar_index, entry_price, bar_index + 8, entry_price, color=color.new(#0284c7, 0), width=2, style=line.style_dashed)
        live_sl_line    := line.new(bar_index, structural_sl, bar_index + 8, structural_sl, color=color.new(#e11d48, 0), width=2, style=line.style_solid)
        live_tp_line    := line.new(bar_index, target_tp, bar_index + 8, target_tp, color=color.new(#059669, 0), width=2, style=line.style_solid)

if (active_trade_state == 0) and (setup_hunting == 1) and in_session and (strategy.position_size == 0)
    retrace_into_discount = (low <= hunt_fib_50) or (low <= hunt_ob_h) or (ltf_fvg_bullish and low <= ltf_fvg_bull_top)
    rejection_confirmed = (close > open) and (close > high[1]) and ltf_vol_ok

    if retrace_into_discount and rejection_confirmed
        active_trade_state := 1
        setup_hunting := 0
        trade_entry_bar := bar_index
        sig_long_fired := true

        entry_price := close
        structural_sl := math.min(hunt_ob_l, low[1]) - (hunt_atr * sl_atr_buffer)
        risk_dist = entry_price - structural_sl
        target_tp := entry_price + (risk_dist * rr_ratio)

        sl_distance = math.abs(entry_price - structural_sl)
        trade_units = f_calc_units(sl_distance)
        suggested_lots := is_gold ? math.max(0.01, math.round(trade_units / 100.0, 2)) : math.max(0.01, math.round(trade_units / 100000.0, 2))

        strategy.entry("15m-Long", strategy.long, qty=trade_units)
        strategy.exit("Exit-Long", from_entry="15m-Long", stop=structural_sl, limit=target_tp)

        pips_sl = math.abs(entry_price - structural_sl) / pip_unit
        pips_tp = math.abs(target_tp - entry_price) / pip_unit
        calc_rr = math.round(pips_tp / math.max(pips_sl, 0.1), 1)

        lbl_text = "▲ BUY @" + str.tostring(entry_price, p_fmt) + "\n" +
                   "SL: " + str.tostring(structural_sl, p_fmt) + " (-" + str.tostring(pips_sl, "#.#") + " p)\n" +
                   "TP: " + str.tostring(target_tp, p_fmt) + " (+" + str.tostring(pips_tp, "#.#") + " p | 1:" + str.tostring(calc_rr, "#.#") + ")\n" +
                   "Lots: " + str.tostring(suggested_lots, "#.##")

        label.new(bar_index, low - (pip_unit * 12), text=lbl_text, style=label.style_label_up, color=color.new(#065f46, 0), textcolor=color.white, size=size.normal)

        live_ob_box := box.new(
             left=bar_index - 8,
             top=hunt_ob_h,
             right=bar_index + 8,
             bottom=hunt_ob_l,
             border_color=color.new(#10b981, 20),
             border_width=1,
             bgcolor=color.new(#10b981, 88),
             text="+OB Demand [" + str.tostring(hunt_ob_l, p_fmt) + " - " + str.tostring(hunt_ob_h, p_fmt) + "]",
             text_color=color.new(#10b981, 0),
             text_size=size.small
             )

        live_entry_line := line.new(bar_index, entry_price, bar_index + 8, entry_price, color=color.new(#0284c7, 0), width=2, style=line.style_dashed)
        live_sl_line    := line.new(bar_index, structural_sl, bar_index + 8, structural_sl, color=color.new(#e11d48, 0), width=2, style=line.style_solid)
        live_tp_line    := line.new(bar_index, target_tp, bar_index + 8, target_tp, color=color.new(#059669, 0), width=2, style=line.style_solid)

// =============================================================================
// STEP 3: ACTIVE TRADE LIFECYCLE (MONITORING UNTIL TP OR SL HIT)
// =============================================================================
if (active_trade_state != 0) and not sig_long_fired and not sig_short_fired
    if not na(live_ob_box)
        box.set_right(live_ob_box, bar_index + 4)
    if not na(live_entry_line)
        line.set_x2(live_entry_line, bar_index + 4)
    if not na(live_sl_line)
        line.set_x2(live_sl_line, bar_index + 4)
    if not na(live_tp_line)
        line.set_x2(live_tp_line, bar_index + 4)

    trade_finished = false

    if active_trade_state == 1
        if high >= target_tp
            trade_finished := true
            p_won = math.abs(target_tp - entry_price) / pip_unit
            label.new(bar_index, high + (pip_unit * 8), text="🎯 TP HIT\n+" + str.tostring(p_won, "#.#") + " p", style=label.style_label_down, color=color.new(#059669, 0), textcolor=color.white, size=size.small)
        else if low <= structural_sl
            trade_finished := true
            p_lost = math.abs(entry_price - structural_sl) / pip_unit
            label.new(bar_index, low - (pip_unit * 8), text="🛑 SL HIT\n-" + str.tostring(p_lost, "#.#") + " p", style=label.style_label_up, color=color.new(#e11d48, 0), textcolor=color.white, size=size.small)
        else if (bar_index - trade_entry_bar) >= max_trade_bars
            trade_finished := true

    else if active_trade_state == -1
        if low <= target_tp
            trade_finished := true
            p_won = math.abs(entry_price - target_tp) / pip_unit
            label.new(bar_index, low - (pip_unit * 8), text="🎯 TP HIT\n+" + str.tostring(p_won, "#.#") + " p", style=label.style_label_up, color=color.new(#059669, 0), textcolor=color.white, size=size.small)
        else if high >= structural_sl
            trade_finished := true
            p_lost = math.abs(structural_sl - entry_price) / pip_unit
            label.new(bar_index, high + (pip_unit * 8), text="🛑 SL HIT\n-" + str.tostring(p_lost, "#.#") + " p", style=label.style_label_down, color=color.new(#e11d48, 0), textcolor=color.white, size=size.small)
        else if (bar_index - trade_entry_bar) >= max_trade_bars
            trade_finished := true

    if trade_finished
        if not na(live_ob_box)
            box.set_right(live_ob_box, bar_index)
        if not na(live_entry_line)
            line.set_x2(live_entry_line, bar_index)
        if not na(live_sl_line)
            line.set_x2(live_sl_line, bar_index)
        if not na(live_tp_line)
            line.set_x2(live_tp_line, bar_index)

        active_trade_state := 0
        last_trade_exit_bar := bar_index

// =============================================================================
// REALTIME WEBHOOK ALERT GENERATION
// =============================================================================
f_build_json(is_long) =>
    dir_str = is_long ? "LONG" : "SHORT"
    calc_rr = (structural_sl != entry_price) ? math.abs(target_tp - entry_price) / math.abs(entry_price - structural_sl) : rr_ratio

    "{" +
     "\"event\":\"forex_signal\"," +
     "\"strategy\":\"adaptive_1h_refined_breakout\"," +
     "\"version\":\"2.0.0\"," +
     "\"symbol\":\"" + syminfo.ticker + "\"," +
     "\"exchange\":\"" + syminfo.prefix + "\"," +
     "\"timeframe\":\"" + timeframe.period + "\"," +
     "\"direction\":\"" + dir_str + "\"," +
     "\"signal_time\":\"" + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + "\"," +
     "\"price\":" + str.tostring(close, p_fmt) + "," +
     "\"entry\":" + str.tostring(entry_price, p_fmt) + "," +
     "\"stop_loss\":" + str.tostring(structural_sl, p_fmt) + "," +
     "\"take_profit\":" + str.tostring(target_tp, p_fmt) + "," +
     "\"risk_reward\":" + str.tostring(calc_rr, "#.#") + "," +
     "\"signal_score\":95," +
     "\"adx\":" + str.tostring(h1_adx_confirmed, "#.##") + "," +
     "\"rsi\":" + str.tostring(h1_rsi_confirmed, "#.##") + "," +
     "\"atr\":" + str.tostring(h1_atr_confirmed, p_fmt) + "," +
     "\"roc\":0.35," +
     "\"suggested_lots\":" + str.tostring(suggested_lots, "#.##") + "," +
     "\"risk_percent\":" + str.tostring(risk_pct, "#.#") + "," +
     "\"entry_type\":\"ICT_OTE_REFINEMENT\"," +
     "\"htf_regime\":\"" + (is_long ? "BULLISH" : "BEARISH") + "\"," +
     "\"breakout_length\":" + str.tostring(donchian_len) + "," +
     "\"atr_multiplier\":" + str.tostring(sl_atr_buffer, "#.##") + "," +
     "\"strategy_version\":\"2.0.0\"," +
     "\"webhook_secret\":\"" + webhook_secret + "\"," +
     "\"environment\":\"" + env_label + "\"" +
     "}"

if sig_long_fired
    alert(f_build_json(true), alert.freq_once_per_bar_close)

if sig_short_fired
    alert(f_build_json(false), alert.freq_once_per_bar_close)
