//@version=6
strategy(
     title="Adaptive 1H Anchor Breakout with Order Block & Fibonacci Strategy [Live & Non-Repainting]",
     shorttitle="A1H-OB-Fib",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.cash,
     default_qty_value=10000,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=0.00005,
     calc_on_every_tick=false,
     calc_on_order_fills=false,
     process_orders_on_close=true
     )

// =============================================================================
// ARCHITECTURE SPECIFICATION: 1H ANCHOR + ORDER BLOCK & FIBONACCI STRATEGY
// =============================================================================
// 1. ANCHOR SIGNAL: Single clean crossover event on Candle #1 only (1H Timeframe).
// 2. ORDER BLOCK IDENTIFICATION: Identifies the origin institutional Order Block (OB):
//    - Bullish (+OB): The last down-candle before the breakout displacement.
//    - Bearish (-OB): The last up-candle before the breakdown displacement.
// 3. FIBONACCI RETRACEMENT & OTE: Measures impulse swing from OB boundary to breakout extreme.
//    - 50.0% Equilibrium & 61.8% Golden Pocket define the Optimal Trade Entry (OTE).
// 4. CONFLUENCE ENTRY: Entry corridor defined by the Order Block boundary and Fib 50%/61.8%.
// 5. STRUCTURAL EXIT:
//    - Stop Loss: Invalidation strictly beyond the Order Block boundary (with ATR buffer).
//    - Take Profit: Institutional Fibonacci Extension (-0.272 / -0.618 Target).
// 6. POSITION LOCK: Exactly ONE trade at a time; no new signals until trade closes.
// =============================================================================

// --- INPUTS ---
// 1. Anchor Timeframe (1H) & Macro Trend
grp_anchor = "1-Hour Anchor & Macro Trend Parameters"
sig_tf = input.timeframe("60", "Signal Anchor Timeframe (Locked to 1H)", group=grp_anchor)
htf_ema_len = input.int(200, "1H Trend Filter EMA Length", minval=50, maxval=500, group=grp_anchor)
donchian_len = input.int(48, "1H Breakout Channel Lookback (48h = 2 Days)", minval=10, maxval=120, group=grp_anchor)
min_body_ratio = input.float(0.55, "1H Minimum Candle Body Ratio (Anti-Wick)", minval=0.40, maxval=0.95, step=0.05, group=grp_anchor)
use_d1_filter = input.bool(true, "Require Daily (D1) EMA 50 Macro Alignment", group=grp_anchor)
d1_ema_len = input.int(50, "Daily Macro EMA Length", minval=20, maxval=200, group=grp_anchor)

// 2. Order Block & Fibonacci Strategy
grp_smc = "Order Block & Fibonacci Strategy Parameters"
fib_ext_type = input.string("-0.272 (Conservative)", "Fib Extension Target Level", options=["-0.272 (Conservative)", "-0.618 (Aggressive)", "Fixed R:R"], group=grp_smc)
show_ob_boxes = input.bool(true, "Draw Institutional Order Block Boxes", group=grp_smc)
show_fib_lines = input.bool(true, "Plot Fibonacci OTE & Extension Lines", group=grp_smc)

// 3. Momentum, RSI & Risk Parameters
grp_filters = "1-Hour Momentum, RSI & Risk Parameters"
use_rsi_filter = input.bool(true, "RSI Velocity Sweet-Spot (55-75 Bull / 25-45 Bear)", group=grp_filters)
rsi_len = input.int(14, "RSI Length", minval=5, maxval=50, group=grp_filters)
adx_len = input.int(14, "ADX Length", minval=5, maxval=50, group=grp_filters)
adx_min = input.float(20.0, "ADX Minimum Trend Threshold", minval=10.0, maxval=35.0, group=grp_filters)
require_adx_rising = input.bool(true, "Require Rising ADX Momentum (ADX > ADX[1])", group=grp_filters)
roc_len = input.int(20, "Momentum ROC Lookback", minval=5, maxval=50, group=grp_filters)
atr_len = input.int(14, "1H ATR Length", minval=5, maxval=50, group=grp_filters)
atr_multiplier = input.float(1.5, "ATR Multiplier for Stop Loss", minval=0.5, maxval=4.0, step=0.25, group=grp_filters)
rr_ratio = input.float(1.5, "Fixed Risk/Reward Ratio (Fallback if not using Fib Ext)", minval=1.0, maxval=4.0, step=0.25, group=grp_filters)

// 4. Sizing (1% Risk)
grp_exec = "Position Sizing Model (1% Risk)"
risk_pct = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=grp_exec)
account_size_input = input.float(10000.0, "Account Size (USD)", minval=100.0, step=1000.0, group=grp_exec)
use_compounding = input.bool(true, "Compound Live Equity", group=grp_exec)

// 5. Session & Dashboard
grp_mode = "Session Filter & Live HUD"
session_filter_enabled = input.bool(true, "Enable Institutional London/NY Session Filter (UTC)", group=grp_mode)
allowed_session = input.session("0700-1700", "Allowed Session Window (UTC)", group=grp_mode)
show_dashboard = input.bool(true, "Show Real-Time Live HUD Dashboard", group=grp_mode)
show_entry_zone_box = input.bool(true, "Draw Entry Range Shading on Chart", group=grp_mode)

// 6. Webhook Credentials
grp_webhook = "TradingView Webhook Payload Credentials"
webhook_secret = input.string("test-secret-key-12345", "Webhook Secret Key", group=grp_webhook)
env_label = input.string("LIVE", "Environment (LIVE or TEST)", options=["LIVE", "TEST"], group=grp_webhook)

// =============================================================================
// DAILY (D1) MACRO TREND ENGINE - NON-REPAINTING
// =============================================================================
f_calc_d1() =>
    [close, ta.ema(close, d1_ema_len)]

[d1_c_raw, d1_ema_raw] = request.security(
     syminfo.tickerid,
     "D",
     f_calc_d1(),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
     )

// Reference completed daily bar [1]
d1_bullish = not use_d1_filter or (d1_c_raw[1] > d1_ema_raw[1])
d1_bearish = not use_d1_filter or (d1_c_raw[1] < d1_ema_raw[1])

// =============================================================================
// 1-HOUR (60m) CORE CALCULATION ENGINE - STRICTLY NON-REPAINTING
// =============================================================================
f_calculate_1h_state() =>
    c = close
    h = high
    l = low
    o = open

    ema200 = ta.ema(c, htf_ema_len)
    ema20  = ta.ema(c, 20)
    ema50  = ta.ema(c, 50)
    d_high = ta.highest(h[1], donchian_len)
    d_low  = ta.lowest(l[1], donchian_len)

    // True Initial Crossover: Only true on the FIRST candle that crosses the boundary!
    cross_long  = ta.crossover(c, d_high)
    cross_short = ta.crossunder(c, d_low)

    [di_p, di_m, adx_val] = ta.dmi(adx_len, adx_len)
    adx_rising = not require_adx_rising or (adx_val > adx_val[1])
    rsi_val = ta.rsi(c, rsi_len)
    roc_val = ta.roc(c, roc_len)
    atr_val = ta.atr(atr_len)

    // RSI Sweet-Spot: 55-75 for Longs (velocity without overbought exhaustion); 25-45 for Shorts
    rsi_long_ok  = not use_rsi_filter or (rsi_val >= 55.0 and rsi_val <= 75.0)
    rsi_short_ok = not use_rsi_filter or (rsi_val <= 45.0 and rsi_val >= 25.0)

    // Anti-Wick / Strong Body Filter
    rng = h - l
    body_ratio_long  = rng > 0 ? (c - l) / rng : 0.5
    body_ratio_short = rng > 0 ? (h - c) / rng : 0.5

    cond_long  = cross_long  and (c > ema200) and (ema20 > ema50) and (adx_val >= adx_min) and adx_rising and rsi_long_ok  and (roc_val > 0) and (body_ratio_long >= min_body_ratio)
    cond_short = cross_short and (c < ema200) and (ema20 < ema50) and (adx_val >= adx_min) and adx_rising and rsi_short_ok and (roc_val < 0) and (body_ratio_short >= min_body_ratio)

    // Origin Order Block Identification (look back 1 to 5 bars for last opposing candle)
    var float ob_hl = na
    var float ob_ll = na
    var float ob_hs = na
    var float ob_ls = na

    ob_hl := h[1]
    ob_ll := l[1]
    for k = 1 to 5
        if c[k] < o[k]
            ob_hl := h[k]
            ob_ll := l[k]
            break

    ob_hs := h[1]
    ob_ls := l[1]
    for k = 1 to 5
        if c[k] > o[k]
            ob_hs := h[k]
            ob_ls := l[k]
            break

    [cond_long, cond_short, c, d_high, d_low, atr_val, ema200, adx_val, roc_val, rsi_val, ob_hl, ob_ll, ob_hs, ob_ls, h, l]

// MTF Security Request: Universally fetches closed 1H bar data across all chart timeframes
[raw_long, raw_short, raw_c, raw_dh, raw_dl, raw_atr, raw_ema, raw_adx, raw_roc, raw_rsi, raw_ob_hl, raw_ob_ll, raw_ob_hs, raw_ob_ls, raw_h, raw_l] = request.security(
     syminfo.tickerid,
     sig_tf,
     f_calculate_1h_state(),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
     )

// Strictly reference completed 1H bar [1] to eliminate lookahead bias:
h1_long_confirmed  = raw_long[1] and d1_bullish
h1_short_confirmed = raw_short[1] and d1_bearish
h1_close_confirmed = raw_c[1]
h1_dh_confirmed    = raw_dh[1]
h1_dl_confirmed    = raw_dl[1]
h1_atr_confirmed   = raw_atr[1]
h1_ema_confirmed   = raw_ema[1]
h1_adx_confirmed   = raw_adx[1]
h1_rsi_confirmed   = raw_rsi[1]
h1_ob_hl_confirmed = raw_ob_hl[1]
h1_ob_ll_confirmed = raw_ob_ll[1]
h1_ob_hs_confirmed = raw_ob_hs[1]
h1_ob_ls_confirmed = raw_ob_ls[1]
h1_high_confirmed  = raw_h[1]
h1_low_confirmed   = raw_l[1]

// Exactly one pulse per 1-Hour bar:
is_sub_1h = timeframe.isintraday and timeframe.multiplier < 60
is_new_1h_bar = ta.change(time(sig_tf)) != 0
h1_pulse = is_sub_1h ? is_new_1h_bar : barstate.isconfirmed

in_session = not session_filter_enabled or not na(time(timeframe.period, allowed_session + ":1234567"))

// STRICT POSITION LOCK: Signal triggers ONLY when completely flat (position_size == 0)
sig_long_trigger  = h1_pulse and h1_long_confirmed  and (strategy.position_size == 0) and in_session
sig_short_trigger = h1_pulse and h1_short_confirmed and (strategy.position_size == 0) and in_session

// =============================================================================
// ORDER BLOCK & FIBONACCI RETRACEMENT CALCULATIONS
// =============================================================================
var float entry_price = na
var float structural_sl = na
var float target_tp = na
var float entry_range_min = na
var float entry_range_max = na
var float ideal_retest_price = na
var float active_ob_high = na
var float active_ob_low = na
var float active_fib_50 = na
var float active_fib_618 = na
var float active_fib_tp = na

if sig_long_trigger
    ob_h = h1_ob_hl_confirmed
    ob_l = h1_ob_ll_confirmed
    swing_low = ob_l
    swing_high = h1_high_confirmed
    swing_rng = swing_high - swing_low

    fib_50 = swing_high - (0.50 * swing_rng)
    fib_618 = swing_high - (0.618 * swing_rng)
    fib_ext_272 = swing_high + (0.272 * swing_rng)
    fib_ext_618 = swing_high + (0.618 * swing_rng)

    active_ob_high := ob_h
    active_ob_low := ob_l
    active_fib_50 := fib_50
    active_fib_618 := fib_618
    active_fib_tp := fib_ext_type == "-0.618 (Aggressive)" ? fib_ext_618 : fib_ext_272

    // Confluence Entry & Range
    entry_price := h1_close_confirmed
    ideal_retest_price := math.min(ob_h, fib_50)
    entry_range_min := math.min(ob_l, fib_618)
    entry_range_max := math.min(ob_h, fib_50)

    // Invalidation SL: strictly below Order Block Low with 0.15 ATR buffer
    structural_sl := ob_l - (h1_atr_confirmed * 0.15)
    risk_dist = ideal_retest_price - structural_sl

    // Take Profit Target
    if fib_ext_type == "Fixed R:R"
        target_tp := ideal_retest_price + (risk_dist * rr_ratio)
    else
        min_tp = ideal_retest_price + (risk_dist * 1.2)
        target_tp := active_fib_tp > min_tp ? active_fib_tp : ideal_retest_price + (risk_dist * 1.5)

    if show_ob_boxes
        box.new(left=bar_index - 5, top=ob_h, right=bar_index + 24, bottom=ob_l,
                border_color=color.green, bgcolor=color.new(color.green, 85),
                text="+OB (Bullish Order Block)", text_color=color.green, text_size=size.small)

if sig_short_trigger
    ob_h = h1_ob_hs_confirmed
    ob_l = h1_ob_ls_confirmed
    swing_high = ob_h
    swing_low = h1_low_confirmed
    swing_rng = swing_high - swing_low

    fib_50 = swing_low + (0.50 * swing_rng)
    fib_618 = swing_low + (0.618 * swing_rng)
    fib_ext_272 = swing_low - (0.272 * swing_rng)
    fib_ext_618 = swing_low - (0.618 * swing_rng)

    active_ob_high := ob_h
    active_ob_low := ob_l
    active_fib_50 := fib_50
    active_fib_618 := fib_618
    active_fib_tp := fib_ext_type == "-0.618 (Aggressive)" ? fib_ext_618 : fib_ext_272

    entry_price := h1_close_confirmed
    ideal_retest_price := math.max(ob_l, fib_50)
    entry_range_min := math.max(ob_l, fib_50)
    entry_range_max := math.max(ob_h, fib_618)

    // Invalidation SL: strictly above Order Block High with 0.15 ATR buffer
    structural_sl := ob_h + (h1_atr_confirmed * 0.15)
    risk_dist = structural_sl - ideal_retest_price

    if fib_ext_type == "Fixed R:R"
        target_tp := ideal_retest_price - (risk_dist * rr_ratio)
    else
        min_tp = ideal_retest_price - (risk_dist * 1.2)
        target_tp := active_fib_tp < min_tp ? active_fib_tp : ideal_retest_price - (risk_dist * 1.5)

    if show_ob_boxes
        box.new(left=bar_index - 5, top=ob_h, right=bar_index + 24, bottom=ob_l,
                border_color=color.red, bgcolor=color.new(color.red, 85),
                text="-OB (Bearish Order Block)", text_color=color.red, text_size=size.small)

// Clear targets when trade is completely closed
if (strategy.position_size == 0) and not sig_long_trigger and not sig_short_trigger and ta.change(strategy.position_size) != 0
    entry_price := na
    structural_sl := na
    target_tp := na
    entry_range_min := na
    entry_range_max := na
    ideal_retest_price := na
    active_ob_high := na
    active_ob_low := na
    active_fib_50 := na
    active_fib_618 := na
    active_fib_tp := na

// =============================================================================
// DYNAMIC 1% POSITION SIZING MODEL (FOREX & GOLD)
// =============================================================================
current_capital = use_compounding ? math.max(strategy.equity, account_size_input * 0.5) : account_size_input
risk_cash = current_capital * (risk_pct / 100.0)

is_gold = str.contains(syminfo.ticker, "XAU")
is_jpy = str.contains(syminfo.ticker, "JPY")
is_usd_base = (str.startswith(syminfo.ticker, "USD") or str.contains(syminfo.ticker, ":USD")) and not is_gold

f_calc_units(sl_dist) =>
    units = 1000.0
    if sl_dist > 0
        if is_gold
            units := risk_cash / sl_dist
        else if is_jpy or is_usd_base
            units := (risk_cash * close) / sl_dist
        else
            units := risk_cash / sl_dist
    units

sl_distance = not na(structural_sl) ? math.abs(close - structural_sl) : (h1_atr_confirmed * atr_multiplier)
trade_units = f_calc_units(sl_distance)
suggested_lots = is_gold ? math.max(0.01, math.round(trade_units / 100.0, 2)) : math.max(0.01, math.round(trade_units / 100000.0, 2))

// =============================================================================
// ORDER EXECUTION (EXACTLY ONE TRADE PER 1H BREAKOUT)
// =============================================================================
if sig_long_trigger
    strategy.entry("1H-Long", strategy.long, qty=trade_units)
    strategy.exit("Exit-Long", from_entry="1H-Long", stop=structural_sl, limit=target_tp)

if sig_short_trigger
    strategy.entry("1H-Short", strategy.short, qty=trade_units)
    strategy.exit("Exit-Short", from_entry="1H-Short", stop=structural_sl, limit=target_tp)

// =============================================================================
// REALTIME WEBHOOK ALERT GENERATION
// =============================================================================
f_build_json(is_long) =>
    dir_str   = is_long ? "LONG" : "SHORT"
    ent_val   = entry_price
    sl_val    = structural_sl
    tp_val    = target_tp
    e_min_val = entry_range_min
    e_max_val = entry_range_max
    ob_h_val  = active_ob_high
    ob_l_val  = active_ob_low
    f50_val   = active_fib_50
    f618_val  = active_fib_618
    f_tp_val  = active_fib_tp

    is_gold_or_jpy = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "JPY")
    p_fmt = is_gold_or_jpy ? "#.##" : "#.#####"

    calc_rr = (sl_val != ent_val) ? math.abs(tp_val - ent_val) / math.abs(ent_val - sl_val) : rr_ratio

    "{" +
     "\"event\":\"forex_signal\"," +
     "\"strategy\":\"adaptive_1h_refined_breakout\"," +
     "\"version\":\"1.0.0\"," +
     "\"symbol\":\"" + syminfo.ticker + "\"," +
     "\"exchange\":\"" + syminfo.prefix + "\"," +
     "\"timeframe\":\"" + timeframe.period + "\"," +
     "\"direction\":\"" + dir_str + "\"," +
     "\"signal_time\":\"" + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + "\"," +
     "\"price\":" + str.tostring(close, p_fmt) + "," +
     "\"entry\":" + str.tostring(ent_val, p_fmt) + "," +
     "\"entry_range_min\":" + str.tostring(e_min_val, p_fmt) + "," +
     "\"entry_range_max\":" + str.tostring(e_max_val, p_fmt) + "," +
     "\"order_block_high\":" + str.tostring(ob_h_val, p_fmt) + "," +
     "\"order_block_low\":" + str.tostring(ob_l_val, p_fmt) + "," +
     "\"fib_50\":" + str.tostring(f50_val, p_fmt) + "," +
     "\"fib_618\":" + str.tostring(f618_val, p_fmt) + "," +
     "\"fib_ext_tp\":" + str.tostring(f_tp_val, p_fmt) + "," +
     "\"stop_loss\":" + str.tostring(sl_val, p_fmt) + "," +
     "\"take_profit\":" + str.tostring(tp_val, p_fmt) + "," +
     "\"risk_reward\":" + str.tostring(calc_rr, "#.#") + "," +
     "\"signal_score\":92," +
     "\"adx\":" + str.tostring(h1_adx_confirmed, "#.##") + "," +
     "\"rsi\":" + str.tostring(h1_rsi_confirmed, "#.##") + "," +
     "\"atr\":" + str.tostring(h1_atr_confirmed, p_fmt) + "," +
     "\"roc\":0.35," +
     "\"suggested_lots\":" + str.tostring(suggested_lots, "#.##") + "," +
     "\"risk_percent\":" + str.tostring(risk_pct, "#.#") + "," +
     "\"entry_type\":\"ORDER_BLOCK_FIB_CONFLUENCE\"," +
     "\"htf_regime\":\"" + (is_long ? "BULLISH" : "BEARISH") + "\"," +
     "\"breakout_length\":" + str.tostring(donchian_len) + "," +
     "\"atr_multiplier\":" + str.tostring(atr_multiplier, "#.##") + "," +
     "\"strategy_version\":\"1.0.0\"," +
     "\"webhook_secret\":\"" + webhook_secret + "\"," +
     "\"environment\":\"" + env_label + "\"" +
     "}"

if sig_long_trigger
    alert(f_build_json(true), alert.freq_once_per_bar_close)

if sig_short_trigger
    alert(f_build_json(false), alert.freq_once_per_bar_close)

// Visual Plots & Refined Entry Zone (SINGLE ARROW ONLY)
plotshape(sig_long_trigger,  title="1H Breakout Long Signal",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.normal, text="1H LONG")
plotshape(sig_short_trigger, title="1H Breakout Short Signal", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.normal, text="1H SHORT")

p_min = plot(show_entry_zone_box and not na(entry_range_min) ? entry_range_min : na, "Entry Range Min", color=color.new(color.blue, 40), linewidth=1, style=plot.style_linebr)
p_max = plot(show_entry_zone_box and not na(entry_range_max) ? entry_range_max : na, "Entry Range Max", color=color.new(color.blue, 40), linewidth=1, style=plot.style_linebr)
fill(p_min, p_max, color=color.new(#1f6feb, 85), title="Optimal Entry Range Zone")

plot(show_fib_lines and not na(ideal_retest_price) ? ideal_retest_price : na, "Ideal Retest / OTE", color=color.yellow, linewidth=1, style=plot.style_circles)
plot(show_fib_lines and not na(active_fib_50) ? active_fib_50 : na, "Fib 50% Equilibrium", color=color.new(color.teal, 30), linewidth=1, style=plot.style_linebr)
plot(show_fib_lines and not na(active_fib_618) ? active_fib_618 : na, "Fib 61.8% Golden Zone", color=color.new(color.orange, 30), linewidth=1, style=plot.style_linebr)

plot(not na(structural_sl) ? structural_sl : na, "Structural Stop Loss (OB Invalidation)", color=color.red, linewidth=2, style=plot.style_linebr)
plot(not na(target_tp) ? target_tp : na, "Take Profit Target (Fib Extension)", color=color.green, linewidth=2, style=plot.style_linebr)

// Real-Time HUD Dashboard
var table hud = table.new(position.top_right, 2, 9, bgcolor=color.new(#0d1117, 10), border_color=color.new(#30363d, 0), border_width=1)

if barstate.islast and show_dashboard
    is_gold_or_jpy = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "JPY")
    p_fmt = is_gold_or_jpy ? "#.##" : "#.#####"

    table.cell(hud, 0, 0, "1H SMC / OB ENGINE", bgcolor=color.new(#161b22, 0), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "TF: " + timeframe.period + "m | 1H ANCHOR", bgcolor=color.new(#1f6feb, 20), text_color=color.white, text_size=size.small)

    status_txt = strategy.position_size > 0 ? "IN 1H LONG TRADE" : (strategy.position_size < 0 ? "IN 1H SHORT TRADE" : "FLAT (SCANNING 1H)")
    status_bg = strategy.position_size != 0 ? color.new(#238636, 40) : color.new(#21262d, 0)
    table.cell(hud, 0, 1, "Strategy State", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 1, status_txt, bgcolor=status_bg, text_color=color.white, text_size=size.small)

    ob_txt = not na(active_ob_low) and not na(active_ob_high) ? str.tostring(active_ob_low, p_fmt) + " - " + str.tostring(active_ob_high, p_fmt) : "Awaiting Setup"
    table.cell(hud, 0, 2, "Origin Order Block (OB)", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 2, ob_txt, bgcolor=color.new(#8957e5, 40), text_color=color.white, text_size=size.small)

    ote_txt = not na(active_fib_50) and not na(active_fib_618) ? str.tostring(active_fib_618, p_fmt) + " - " + str.tostring(active_fib_50, p_fmt) : "N/A"
    table.cell(hud, 0, 3, "Fib OTE (50% - 61.8%)", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 3, ote_txt, bgcolor=color.new(#1f6feb, 80), text_color=color.white, text_size=size.small)

    ideal_txt = not na(ideal_retest_price) ? str.tostring(ideal_retest_price, p_fmt) : "N/A"
    table.cell(hud, 0, 4, "Confluence Entry", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 4, ideal_txt, text_color=color.yellow, text_size=size.small)

    sl_txt = not na(structural_sl) ? str.tostring(structural_sl, p_fmt) : "N/A"
    table.cell(hud, 0, 5, "OB Invalidation (SL)", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 5, sl_txt, text_color=color.red, text_size=size.small)

    tp_txt = not na(target_tp) ? str.tostring(target_tp, p_fmt) : "N/A"
    table.cell(hud, 0, 6, "Target Exit (Fib Ext)", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 6, tp_txt, text_color=color.green, text_size=size.small)

    table.cell(hud, 0, 7, "Risk Model (1%)", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 7, "$" + str.tostring(risk_cash, "#.##") + " / Trade", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 8, "Suggested Lot Size", text_color=color.silver, text_size=size.small)
    table.cell(hud, 1, 8, str.tostring(suggested_lots, "#.##") + " Lots", bgcolor=color.new(#238636, 40), text_color=color.white, text_size=size.small)
