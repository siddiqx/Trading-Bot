//@version=6
indicator(
     title="Institutional Trend Breakout & Order Block Engine [Finalized]",
     shorttitle="ICT-Breakout-Engine",
     overlay=true,
     max_bars_back=500,
     max_boxes_count=500,
     max_lines_count=500,
     max_labels_count=500
     )

// =============================================================================
// STRATEGY SPECIFICATION (FINALIZED 24/7 INSTITUTIONAL ARCHITECTURE)
// =============================================================================
// 1. BREAKOUT SETUP:
//    - Confirmed 20-period Donchian Channel High/Low breach on completed bar.
// 2. TREND ALIGNMENT:
//    - Longs: Close > EMA 50 AND EMA 20 > EMA 50 AND EMA 20 Slope > 0.
//    - Shorts: Close < EMA 50 AND EMA 20 < EMA 50 AND EMA 20 Slope < 0.
// 3. ANTI-EXHAUSTION MOMENTUM GUARD:
//    - Longs: 45.0 <= RSI (14) <= 75.0 (Rejects overbought exhaustion).
//    - Shorts: 25.0 <= RSI (14) <= 55.0 (Rejects oversold exhaustion).
// 4. STRUCTURAL ORDER BLOCK STOP LOSS:
//    - Anchored to the Origin Order Block (last opposite candle prior to breakout)
//    - SL Buffer: 0.50 * ATR (14).
//    - Bounded: Minimum 18.0 pips, Maximum 60.0 pips.
// 5. TARGET MATRIX:
//    - Fixed 1 : 1.75 Risk-to-Reward ratio (TP = Entry +/- SL_Dist * 1.75).
// 6. STRICT SINGLE-TRADE LOCK:
//    - While a trade is active (between Entry and TP/SL), ZERO duplicate signals
//      can trigger. A pair only unlocks once price touches either TP or SL.
// =============================================================================

// =============================================================================
// INPUT PARAMETERS
// =============================================================================
grp_strat = "Strategy Execution Parameters"
donchian_len     = input.int(20, "Donchian Breakout Lookback", minval=10, maxval=50, group=grp_strat)
rr_ratio         = input.float(1.75, "Risk / Reward Ratio", minval=1.0, maxval=4.0, step=0.05, group=grp_strat)
sl_atr_mult      = input.float(0.50, "Order Block ATR Buffer", minval=0.10, maxval=1.5, step=0.05, group=grp_strat)
min_sl_pips      = input.float(18.0, "Minimum SL Breathing Room (Pips)", minval=5.0, maxval=40.0, step=1.0, group=grp_strat)
max_sl_pips      = input.float(60.0, "Maximum SL Volatility Cap (Pips)", minval=30.0, maxval=120.0, step=5.0, group=grp_strat)
risk_pct         = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=grp_strat)
account_size     = input.float(10000.0, "Account Size (USD)", minval=100.0, step=1000.0, group=grp_strat)

grp_alerts = "Cloud Webhook Relay Settings"
webhook_secret   = input.string("test-secret-key-12345", "Webhook Secret Key", group=grp_alerts)
env_label        = input.string("LIVE", "Environment (LIVE or TEST)", options=["LIVE", "TEST"], group=grp_alerts)

grp_visuals = "Visual Display & Aesthetics"
show_emas        = input.bool(true, "Show EMA 20 & EMA 50 Trend Lines", group=grp_visuals)
show_donchian    = input.bool(true, "Show Donchian 20 Channel Lines", group=grp_visuals)
show_ob_boxes    = input.bool(true, "Show Origin Order Block Zones", group=grp_visuals)

// =============================================================================
// ASSET INSTRUMENT SPECIFICATIONS
// =============================================================================
is_gold = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD") or str.contains(syminfo.ticker, "GC")
is_jpy  = str.contains(syminfo.ticker, "JPY")
pip_unit = is_gold ? 0.10 : (is_jpy ? 0.01 : 0.0001)
p_fmt = is_gold ? "#.##" : (is_jpy ? "#.###" : "#.#####")
min_sl_dist = min_sl_pips * pip_unit
max_sl_dist = max_sl_pips * pip_unit

// =============================================================================
// CORE INDICATOR CALCULATIONS
// =============================================================================
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema20_slope = ema20 - ema20[1]

donch_high = ta.highest(high[1], donchian_len)
donch_low  = ta.lowest(low[1], donchian_len)

chart_rsi = ta.rsi(close, 14)
chart_atr = ta.atr(14)

// Trend Confirmation:
bullish_trend = (close > ema50) and (ema20 > ema50) and (ema20_slope > 0)
bearish_trend = (close < ema50) and (ema20 < ema50) and (ema20_slope < 0)

// Anti-Exhaustion RSI Guard (Sweet-Spot):
rsi_bullish_ok = (chart_rsi >= 45.0) and (chart_rsi <= 75.0)
rsi_bearish_ok = (chart_rsi >= 25.0) and (chart_rsi <= 55.0)

// 20-Period Breakout on Completed Bar:
long_breakout  = (close > donch_high) and (close[1] <= donch_high[1])
short_breakout = (close < donch_low)  and (close[1] >= donch_low[1])

// Visual EMA and Donchian Plots:
plot(show_emas ? ema20 : na, title="EMA 20", color=color.new(#0284c7, 0), linewidth=2)
plot(show_emas ? ema50 : na, title="EMA 50", color=color.new(#f97316, 0), linewidth=2)
plot(show_donchian ? donch_high : na, title="Donchian 20 High", color=color.new(#10b981, 60), style=plot.style_circles)
plot(show_donchian ? donch_low  : na, title="Donchian 20 Low",  color=color.new(#ef4444, 60), style=plot.style_circles)

// =============================================================================
// ORIGIN ORDER BLOCK DISCOVERY
// =============================================================================
f_find_ob_low() =>
    float ob_l = low
    for i = 1 to 10
        if close[i] < open[i]
            ob_l := low[i]
            break
    ob_l

f_find_ob_high() =>
    float ob_h = high
    for i = 1 to 10
        if close[i] > open[i]
            ob_h := high[i]
            break
    ob_h

// Position Sizing:
risk_cash = account_size * (risk_pct / 100.0)
f_calc_lots(sl_dist) =>
    safe_dist = math.max(sl_dist, min_sl_dist)
    lots = 0.01
    if is_gold
        lots := math.max(0.01, math.round((risk_cash / safe_dist) / 100.0, 2))
    else
        lots := math.max(0.01, math.round((risk_cash / (safe_dist / pip_unit * 10.0)), 2))
    lots

// =============================================================================
// STRICT SINGLE-TRADE STATE MACHINE (LOCKED UNTIL TP OR SL HIT)
// =============================================================================
var bool in_trade = false
var int trade_dir = 0           // 1 = LONG, -1 = SHORT
var float fixed_entry = na
var float fixed_sl = na
var float fixed_tp = na
var float fixed_sl_pips = na
var float fixed_tp_pips = na
var float fixed_lots = na
var int trade_entry_bar = na

var line cur_entry_line = na
var line cur_sl_line    = na
var line cur_tp_line    = na
var box  cur_ob_box     = na

sig_long_fired  = false
sig_short_fired = false

// Monitor Active Trade for Target Resolution:
if in_trade and (bar_index > trade_entry_bar)
    trade_resolved = false
    is_win = false
    
    if (trade_dir == 1) // LONG
        if high >= fixed_tp
            trade_resolved := true
            is_win := true
            label.new(bar_index, high + (pip_unit * 8), text="🎯 TP HIT\n+" + str.tostring(fixed_tp_pips, "#.#") + " p", style=label.style_label_down, color=color.new(#059669, 0), textcolor=color.white, size=size.small)
        else if low <= fixed_sl
            trade_resolved := true
            is_win := false
            label.new(bar_index, low - (pip_unit * 8), text="🛑 SL HIT\n-" + str.tostring(fixed_sl_pips, "#.#") + " p", style=label.style_label_up, color=color.new(#e11d48, 0), textcolor=color.white, size=size.small)

    else if (trade_dir == -1) // SHORT
        if low <= fixed_tp
            trade_resolved := true
            is_win := true
            label.new(bar_index, low - (pip_unit * 8), text="🎯 TP HIT\n+" + str.tostring(fixed_tp_pips, "#.#") + " p", style=label.style_label_up, color=color.new(#059669, 0), textcolor=color.white, size=size.small)
        else if high >= fixed_sl
            trade_resolved := true
            is_win := false
            label.new(bar_index, high + (pip_unit * 8), text="🛑 SL HIT\n-" + str.tostring(fixed_sl_pips, "#.#") + " p", style=label.style_label_down, color=color.new(#e11d48, 0), textcolor=color.white, size=size.small)

    if trade_resolved
        // Permanently freeze line endpoints at exit candle
        if not na(cur_entry_line)
            line.set_x2(cur_entry_line, bar_index)
        if not na(cur_sl_line)
            line.set_x2(cur_sl_line, bar_index)
        if not na(cur_tp_line)
            line.set_x2(cur_tp_line, bar_index)
        if not na(cur_ob_box)
            box.set_right(cur_ob_box, bar_index)

        // Detach active handles
        cur_entry_line := na
        cur_sl_line    := na
        cur_tp_line    := na
        cur_ob_box     := na

        // Unlock pair for subsequent trade discovery
        in_trade  := false
        trade_dir := 0

// Extend active lines horizontally until trade is resolved:
if in_trade
    if not na(cur_entry_line)
        line.set_x2(cur_entry_line, bar_index)
    if not na(cur_sl_line)
        line.set_x2(cur_sl_line, bar_index)
    if not na(cur_tp_line)
        line.set_x2(cur_tp_line, bar_index)
    if not na(cur_ob_box)
        box.set_right(cur_ob_box, bar_index)

// =============================================================================
// NEW TRADE SIGNAL EVALUATION (STRICT SINGLE-TRADE LOCK ENFORCED)
// =============================================================================
// Signals can ONLY trigger when NOT in a trade and on confirmed bar close!
can_trigger = not in_trade and barstate.isconfirmed

// LONG SIGNAL TRIGGER:
if can_trigger and long_breakout and bullish_trend and rsi_bullish_ok
    ob_low = f_find_ob_low()
    sl_candidate = ob_low - (sl_atr_mult * chart_atr)
    sl_dist = math.max(min_sl_dist, math.min(max_sl_dist, close - sl_candidate))

    in_trade := true
    trade_dir := 1
    trade_entry_bar := bar_index
    fixed_entry := close
    fixed_sl := fixed_entry - sl_dist
    fixed_tp := fixed_entry + (sl_dist * rr_ratio)
    fixed_sl_pips := math.round(sl_dist / pip_unit, 1)
    fixed_tp_pips := math.round((fixed_tp - fixed_entry) / pip_unit, 1)
    fixed_lots := f_calc_lots(sl_dist)
    sig_long_fired := true

    // Visual Signal Card:
    lbl_text = "🟢 BUY / LONG @" + str.tostring(fixed_entry, p_fmt) + "\n" +
               "SL: " + str.tostring(fixed_sl, p_fmt) + " (-" + str.tostring(fixed_sl_pips, "#.#") + " p)\n" +
               "TP: " + str.tostring(fixed_tp, p_fmt) + " (+" + str.tostring(fixed_tp_pips, "#.#") + " p | 1:" + str.tostring(rr_ratio, "#.##") + ")\n" +
               "Risk: 1.0% (" + str.tostring(fixed_lots, "#.##") + " lots)"
    label.new(bar_index, low - (pip_unit * 12), text=lbl_text, style=label.style_label_up, color=color.new(#065f46, 0), textcolor=color.white, size=size.normal)

    // Visual Horizontal Trade Bounds:
    cur_entry_line := line.new(bar_index, fixed_entry, bar_index + 1, fixed_entry, color=color.new(#0284c7, 0), width=2, style=line.style_dashed)
    cur_sl_line    := line.new(bar_index, fixed_sl, bar_index + 1, fixed_sl, color=color.new(#e11d48, 0), width=2, style=line.style_solid)
    cur_tp_line    := line.new(bar_index, fixed_tp, bar_index + 1, fixed_tp, color=color.new(#059669, 0), width=2, style=line.style_solid)

    if show_ob_boxes
        cur_ob_box := box.new(left=bar_index - 6, top=fixed_entry, right=bar_index + 1, bottom=ob_low, border_color=color.new(#10b981, 30), bgcolor=color.new(#10b981, 88), text="+OB Demand Zone", text_color=color.new(#10b981, 0), text_size=size.small)

// SHORT SIGNAL TRIGGER:
if can_trigger and short_breakout and bearish_trend and rsi_bearish_ok
    ob_high = f_find_ob_high()
    sl_candidate = ob_high + (sl_atr_mult * chart_atr)
    sl_dist = math.max(min_sl_dist, math.min(max_sl_dist, sl_candidate - close))

    in_trade := true
    trade_dir := -1
    trade_entry_bar := bar_index
    fixed_entry := close
    fixed_sl := fixed_entry + sl_dist
    fixed_tp := fixed_entry - (sl_dist * rr_ratio)
    fixed_sl_pips := math.round(sl_dist / pip_unit, 1)
    fixed_tp_pips := math.round((fixed_entry - fixed_tp) / pip_unit, 1)
    fixed_lots := f_calc_lots(sl_dist)
    sig_short_fired := true

    // Visual Signal Card:
    lbl_text = "🔴 SELL / SHORT @" + str.tostring(fixed_entry, p_fmt) + "\n" +
               "SL: " + str.tostring(fixed_sl, p_fmt) + " (-" + str.tostring(fixed_sl_pips, "#.#") + " p)\n" +
               "TP: " + str.tostring(fixed_tp, p_fmt) + " (+" + str.tostring(fixed_tp_pips, "#.#") + " p | 1:" + str.tostring(rr_ratio, "#.##") + ")\n" +
               "Risk: 1.0% (" + str.tostring(fixed_lots, "#.##") + " lots)"
    label.new(bar_index, high + (pip_unit * 12), text=lbl_text, style=label.style_label_down, color=color.new(#9f1239, 0), textcolor=color.white, size=size.normal)

    // Visual Horizontal Trade Bounds:
    cur_entry_line := line.new(bar_index, fixed_entry, bar_index + 1, fixed_entry, color=color.new(#0284c7, 0), width=2, style=line.style_dashed)
    cur_sl_line    := line.new(bar_index, fixed_sl, bar_index + 1, fixed_sl, color=color.new(#e11d48, 0), width=2, style=line.style_solid)
    cur_tp_line    := line.new(bar_index, fixed_tp, bar_index + 1, fixed_tp, color=color.new(#059669, 0), width=2, style=line.style_solid)

    if show_ob_boxes
        cur_ob_box := box.new(left=bar_index - 6, top=ob_high, right=bar_index + 1, bottom=fixed_entry, border_color=color.new(#ef4444, 30), bgcolor=color.new(#ef4444, 88), text="-OB Supply Zone", text_color=color.new(#ef4444, 0), text_size=size.small)

// =============================================================================
// WEBHOOK JSON ALERT DISPATCHER (STRICT ONCE PER CONFIRMED BAR)
// =============================================================================
f_build_json(is_long) =>
    dir_str = is_long ? "LONG" : "SHORT"
    "{" +
     "\"event\":\"forex_signal\"," +
     "\"symbol\":\"" + syminfo.ticker + "\"," +
     "\"timeframe\":\"" + timeframe.period + "\"," +
     "\"direction\":\"" + dir_str + "\"," +
     "\"signal_time\":\"" + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + "\"," +
     "\"entry\":" + str.tostring(fixed_entry, p_fmt) + "," +
     "\"stop_loss\":" + str.tostring(fixed_sl, p_fmt) + "," +
     "\"take_profit\":" + str.tostring(fixed_tp, p_fmt) + "," +
     "\"risk_reward\":" + str.tostring(rr_ratio, "#.##") + "," +
     "\"signal_score\":92," +
     "\"rsi\":" + str.tostring(chart_rsi, "#.#") + "," +
     "\"atr\":" + str.tostring(math.round(chart_atr / pip_unit, 1), "#.#") + "," +
     "\"suggested_lots\":" + str.tostring(fixed_lots, "#.##") + "," +
     "\"webhook_secret\":\"" + webhook_secret + "\"," +
     "\"environment\":\"" + env_label + "\"" +
     "}"

if sig_long_fired
    alert(f_build_json(true), alert.freq_once_per_bar_close)

if sig_short_fired
    alert(f_build_json(false), alert.freq_once_per_bar_close)
