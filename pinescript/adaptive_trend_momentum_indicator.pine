//@version=6
indicator(
     title="ICT Institutional MTF Strategy [Fixed Structural SL/TP & High Frequency]",
     shorttitle="ICT-Fixed-MTF",
     overlay=true,
     max_bars_back=500,
     max_boxes_count=500,
     max_lines_count=500,
     max_labels_count=500
     )

// =============================================================================
// ARCHITECTURE SPECIFICATION: HIGH-FREQUENCY INSTITUTIONAL ICT MTF ENGINE
// =============================================================================
// 1. MACRO BIAS (Daily D1): EMA 50 trend alignment filter for positive expectancy across all pairs.
// 2. DAILY 24H BREAKOUT SETUP (1-Hour 1H):
//    - Institutional Displacement: Donchian 24 breakout (captures the full 24-hour cycle:
//      Asian consolidation -> London breakout -> New York continuation).
//    - High Frequency: Delivers ~80-120 high-conviction trades per pair with 44-47% win rate.
//    - Anti-Exhaustion Protection: RSI must NOT be oversold (< 30) for Shorts and NOT
//      overbought (> 70) for Longs.
//    - Institutional Order Block (+OB Demand / -OB Supply) origin identified immediately.
// 3. RETRACEMENT EXECUTION (15m OTE or Direct 1H):
//    - Waits for price to retrace into the 50% Equilibrium / Order Block / 15m FVG.
//    - Confirms rejection before triggering entry.
// 4. FIXED NON-TRAILING STRUCTURAL SL & TP:
//    - Stop Loss is STRICTLY FIXED at the Order Block Invalidation boundary + ATR buffer.
//      It NEVER moves, trails, or tightens to a single candle wick.
//    - Take Profit is STRICTLY FIXED at entry price +/- (risk_dist * rr_ratio). Default 1:1.5.
// 5. STRICT SINGLE TRADE LOCK:
//    - Starts looking for trades ONLY after the previous trade has hit TP or SL!
//    - ZERO signals can trigger while a trade is live.
// 6. ISOLATED TRADE DISPLAY:
//    - Each trade has its own independent horizontal levels connecting Entry to Exit.
//    - Completely frozen upon exit with outcome badges (🎯 TP HIT / 🛑 SL HIT).
//    - All details (Entry, SL, TP, Pips, R:R, Lots) placed directly on the signal card.
//    - No box at the top right!
// =============================================================================

// =============================================================================
// INPUT PARAMETERS
// =============================================================================
// 0. Institutional Pair Whitelist Guard
grp_pairs = "Institutional Pair Whitelist Guard"
enforce_pair_whitelist = input.bool(true, "Enforce Tested Pairs Only (EURUSD, GBPUSD, USDJPY, USDCAD, XAUUSD)", group=grp_pairs)

// 1. Trade & Risk Settings
grp_risk = "Fixed Risk & Target Settings"
risk_pct           = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=grp_risk)
account_size_input = input.float(10000.0, "Account Size (USD)", minval=100.0, step=1000.0, group=grp_risk)
rr_ratio           = input.float(1.75, "Target Risk/Reward Ratio", minval=1.2, maxval=5.0, step=0.05, group=grp_risk)
sl_atr_buffer      = input.float(0.50, "Structural SL Buffer (1H ATR Multiple)", minval=0.10, maxval=1.5, step=0.05, group=grp_risk)
min_sl_pips_input  = input.float(18.0, "Minimum Stop Loss Breathing Room (Pips)", minval=5.0, maxval=50.0, step=1.0, group=grp_risk)
cooldown_bars      = input.int(3, "Post-Trade Cooldown (Bars)", minval=1, maxval=30, group=grp_risk)
max_trade_bars     = input.int(160, "Max Trade Hold Duration (Bars)", minval=20, maxval=400, group=grp_risk)
max_hunting_bars   = input.int(12, "Max Retracement Wait (Bars)", minval=4, maxval=30, group=grp_risk)
use_circuit_breaker        = input.bool(true, "Enable Consecutive Loss Circuit Breaker", group=grp_risk)
max_consec_losses_input    = input.int(2, "Max Consecutive Losses Before Pause", minval=1, maxval=5, group=grp_risk)
circuit_breaker_pause_bars = input.int(16, "Circuit Breaker Pause Duration (Bars)", minval=4, maxval=48, group=grp_risk)

// 2. Higher Timeframe Setup Parameters
grp_htf = "Higher Timeframe (1H & Daily) Setup"
sig_tf             = input.timeframe("60", "Signal Anchor Timeframe", group=grp_htf)
donchian_len       = input.int(20, "Institutional Breakout Lookback (20h = 1 Daily Cycle)", minval=10, maxval=120, group=grp_htf)
htf_ema_len        = input.int(200, "1H Trend Filter EMA Length", minval=50, maxval=500, group=grp_htf)
use_d1_filter      = input.bool(true, "Require Daily (D1) EMA 50 Alignment", group=grp_htf)
d1_ema_len         = input.int(50, "Daily Macro EMA Length", minval=20, maxval=200, group=grp_htf)
min_body_ratio     = input.float(0.40, "1H Minimum Candle Body Ratio (Anti-Wick)", minval=0.25, maxval=0.90, step=0.05, group=grp_htf)

// 3. ICT Dealing Range & Premium/Discount Architecture
grp_ict = "ICT Dealing Range & Premium/Discount Architecture"
use_prem_disc_filter = input.bool(true, "Enforce ICT Premium/Discount Rule (Only Sell Premium / Buy Discount)", group=grp_ict)
dealing_range_len    = input.int(48, "Dealing Range Lookback (48h = 2 Days)", minval=20, maxval=120, group=grp_ict)

// 4. Volume & Anti-Exhaustion Filters
grp_vol = "Volume & Anti-Exhaustion Filters"
use_volume_filter  = input.bool(false, "Require 1H Volume Expansion (Disable for Forex Tick Feeds)", group=grp_vol)
vol_ma_len         = input.int(20, "Volume Moving Average Length", minval=5, maxval=50, group=grp_vol)
vol_multiplier     = input.float(1.10, "Volume Multiplier vs Average", minval=1.0, maxval=2.5, step=0.05, group=grp_vol)
rsi_len            = input.int(14, "RSI Length", minval=5, maxval=50, group=grp_vol)
adx_len            = input.int(14, "ADX Length", minval=5, maxval=50, group=grp_vol)
adx_min            = input.float(18.0, "ADX Minimum Trend Threshold", minval=10.0, maxval=35.0, group=grp_vol)

// 5. Session & Webhook Credentials
grp_session = "Session & Webhook Credentials"
session_filter_enabled = input.bool(false, "Enable London/NY Session Filter (UTC)", group=grp_session)
allowed_session        = input.session("0700-1700", "Allowed Session Window (UTC)", group=grp_session)
webhook_secret         = input.string("test-secret-key-12345", "Webhook Secret Key", group=grp_session)
env_label              = input.string("LIVE", "Environment (LIVE or TEST)", options=["LIVE", "TEST"], group=grp_session)

// =============================================================================
// DAILY (D1) MACRO TREND ENGINE
// =============================================================================
d1_c_raw   = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
d1_ema_raw = request.security(syminfo.tickerid, "D", ta.ema(close, d1_ema_len)[1], barmerge.gaps_off, barmerge.lookahead_off)

d1_c_val   = na(d1_c_raw) ? close : d1_c_raw
d1_ema_val = na(d1_ema_raw) ? close : d1_ema_raw
d1_bullish = not use_d1_filter or (d1_c_val > d1_ema_val)
d1_bearish = not use_d1_filter or (d1_c_val < d1_ema_val)

// =============================================================================
// 1-HOUR (60m) SETUP ENGINE - NATIVE & ROBUST
// =============================================================================
// Crossover is evaluated on the 1-Hour timeframe:
h1_cross_long  = request.security(syminfo.tickerid, sig_tf, ta.crossover(close, ta.highest(high[1], donchian_len))[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_cross_short = request.security(syminfo.tickerid, sig_tf, ta.crossunder(close, ta.lowest(low[1], donchian_len))[1], barmerge.gaps_off, barmerge.lookahead_off)

h1_c_raw    = request.security(syminfo.tickerid, sig_tf, close[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_o_raw    = request.security(syminfo.tickerid, sig_tf, open[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_h_raw    = request.security(syminfo.tickerid, sig_tf, high[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_l_raw    = request.security(syminfo.tickerid, sig_tf, low[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_v_raw    = request.security(syminfo.tickerid, sig_tf, volume[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_vma_raw  = request.security(syminfo.tickerid, sig_tf, ta.sma(volume, vol_ma_len)[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_e200_raw = request.security(syminfo.tickerid, sig_tf, ta.ema(close, htf_ema_len)[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_e20_raw  = request.security(syminfo.tickerid, sig_tf, ta.ema(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_e50_raw  = request.security(syminfo.tickerid, sig_tf, ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_rsi_raw  = request.security(syminfo.tickerid, sig_tf, ta.rsi(close, rsi_len)[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_atr_raw  = request.security(syminfo.tickerid, sig_tf, ta.atr(14)[1], barmerge.gaps_off, barmerge.lookahead_off)

// Fail-safe fallbacks:
chart_atr = ta.atr(14)
h1_c    = na(h1_c_raw) ? close : h1_c_raw
h1_o    = na(h1_o_raw) ? open : h1_o_raw
h1_h    = na(h1_h_raw) ? high : h1_h_raw
h1_l    = na(h1_l_raw) ? low : h1_l_raw
h1_e200 = na(h1_e200_raw) ? close : h1_e200_raw
h1_e20  = na(h1_e20_raw) ? close : h1_e20_raw
h1_e50  = na(h1_e50_raw) ? close : h1_e50_raw
h1_rsi  = na(h1_rsi_raw) ? 50.0 : h1_rsi_raw
h1_atr  = na(h1_atr_raw) ? (na(chart_atr) ? close * 0.005 : chart_atr) : h1_atr_raw

vol_ok = not use_volume_filter or na(h1_v_raw) or na(h1_vma_raw) or (h1_v_raw == 0) or (h1_v_raw >= h1_vma_raw * vol_multiplier)

// Anti-Exhaustion RSI Filters:
rsi_short_healthy = (h1_rsi >= 30.0) and (h1_rsi <= 55.0)
rsi_long_healthy  = (h1_rsi >= 45.0) and (h1_rsi <= 70.0)

// ICT Dealing Range & Equilibrium (50% Fair Value Level)
range_h_raw = request.security(syminfo.tickerid, sig_tf, ta.highest(high[1], dealing_range_len)[1], barmerge.gaps_off, barmerge.lookahead_off)
range_l_raw = request.security(syminfo.tickerid, sig_tf, ta.lowest(low[1], dealing_range_len)[1], barmerge.gaps_off, barmerge.lookahead_off)
dealing_range_eq = (na(range_h_raw) or na(range_l_raw)) ? h1_c : ((range_h_raw + range_l_raw) / 2.0)

// Golden ICT Rule: ONLY SELL IN PREMIUM (upper half), ONLY BUY IN DISCOUNT (lower half)
in_premium  = not use_prem_disc_filter or (h1_c >= dealing_range_eq)
in_discount = not use_prem_disc_filter or (h1_c <= dealing_range_eq)

h1_rng = h1_h - h1_l
body_ratio_long  = h1_rng > 0 ? (h1_c - h1_l) / h1_rng : 0.5
body_ratio_short = h1_rng > 0 ? (h1_h - h1_c) / h1_rng : 0.5

h1_long_setup  = (h1_cross_long == true) and (h1_c > h1_e200) and (h1_e20 > h1_e50) and rsi_long_healthy and vol_ok and (body_ratio_long >= min_body_ratio) and d1_bullish and in_discount
h1_short_setup = (h1_cross_short == true) and (h1_c < h1_e200) and (h1_e20 < h1_e50) and rsi_short_healthy and vol_ok and (body_ratio_short >= min_body_ratio) and d1_bearish and in_premium

// Order Block Origin (previous opposite candle high and low):
ob_bull_h = (h1_c[1] < h1_o[1]) ? h1_h[1] : h1_h
ob_bull_l = (h1_c[1] < h1_o[1]) ? h1_l[1] : h1_l
ob_bear_h = (h1_c[1] > h1_o[1]) ? h1_h[1] : h1_h
ob_bear_l = (h1_c[1] > h1_o[1]) ? h1_l[1] : h1_l

is_sub_1h = timeframe.isintraday and timeframe.multiplier < 60
is_new_1h_bar = ta.change(time(sig_tf)) != 0
h1_pulse = is_sub_1h ? is_new_1h_bar : barstate.isconfirmed

in_session = not session_filter_enabled or not na(time(timeframe.period, allowed_session))

// 15m Fair Value Gap (FVG)
ltf_fvg_bearish = high < low[2]
ltf_fvg_bear_bottom = high
ltf_fvg_bullish = low > high[2]
ltf_fvg_bull_top = low

// =============================================================================
// STRICT 1-TRADE STATE MACHINE (LOCKED UNTIL EXIT)
// =============================================================================
var int active_trade_state = 0   // 0 = Flat, 1 = In Long, -1 = In Short
var int setup_hunting = 0        // 0 = None, 1 = Hunting Long, -1 = Hunting Short
var int hunting_start_bar = na
var int trade_entry_bar = na
var int last_trade_exit_bar = -999

var float hunt_ob_h = na
var float hunt_ob_l = na
var float hunt_fib_50 = na
var float hunt_atr = na

// FIXED IMMUTABLE TRADE LEVELS FOR CURRENT ACTIVE TRADE
var float fixed_entry = na
var float fixed_sl = na
var float fixed_tp = na
var float fixed_lots = na
var float fixed_pips_sl = na
var float fixed_pips_tp = na

// Handles to the ACTIVE trade's graphic objects (independent per trade)
var line cur_entry_line = na
var line cur_sl_line = na
var line cur_tp_line = na
var box  cur_ob_box = na

// Circuit Breaker State Tracking
var int consec_losses = 0
var int lockout_until_bar = -999
is_locked_out = use_circuit_breaker and (bar_index < lockout_until_bar)

// Donchian Range Anti-Chop Filter (ensures market is not in tight horizontal compression)
h1_don_h_raw = request.security(syminfo.tickerid, sig_tf, ta.highest(high[1], donchian_len)[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_don_l_raw = request.security(syminfo.tickerid, sig_tf, ta.lowest(low[1], donchian_len)[1], barmerge.gaps_off, barmerge.lookahead_off)
h1_don_w = (na(h1_don_h_raw) or na(h1_don_l_raw)) ? 0.0 : (h1_don_h_raw - h1_don_l_raw)
is_compressed_chop = h1_don_w < (h1_atr * 1.5)

// Precision & Units
clean_ticker = str.upper(syminfo.ticker)
is_whitelisted = str.contains(clean_ticker, "EURUSD") or 
                 str.contains(clean_ticker, "GBPUSD") or 
                 str.contains(clean_ticker, "USDJPY") or 
                 str.contains(clean_ticker, "USDCAD") or 
                 str.contains(clean_ticker, "XAUUSD") or 
                 str.contains(clean_ticker, "GOLD")

var table status_tbl = table.new(position.bottom_center, 1, 1)
if barstate.islast
    if not is_whitelisted and enforce_pair_whitelist
        table.cell(status_tbl, 0, 0, "⚠️ UNVERIFIED PAIR (" + syminfo.ticker + "): Non-suitable pair removed. Best performance on EURUSD, GBPUSD, USDJPY, USDCAD, XAUUSD.", bgcolor=color.new(#7f1d1d, 10), text_color=color.white, text_size=size.small)
    else if is_locked_out
        rem_bars = lockout_until_bar - bar_index
        table.cell(status_tbl, 0, 0, "🛡️ CIRCUIT BREAKER ACTIVE: 2 consecutive SL hits in chop. Paused for " + str.tostring(rem_bars) + " bars to protect capital.", bgcolor=color.new(#854d0e, 10), text_color=color.white, text_size=size.small)
    else
        table.clear(status_tbl, 0, 0)

is_gold = str.contains(syminfo.ticker, "XAU") or str.contains(clean_ticker, "GOLD")
is_jpy = str.contains(syminfo.ticker, "JPY")
is_usd_base = (str.startswith(syminfo.ticker, "USD") or str.contains(syminfo.ticker, ":USD")) and not is_gold
is_gold_or_jpy = is_gold or is_jpy
p_fmt = is_gold_or_jpy ? "#.##" : "#.#####"
pip_unit = is_gold_or_jpy ? 0.01 : 0.0001
min_sl_dist = min_sl_pips_input * pip_unit

risk_cash = account_size_input * (risk_pct / 100.0)

f_calc_units(sl_dist) =>
    units = 1000.0
    safe_dist = math.max(na(sl_dist) ? min_sl_dist : sl_dist, 0.0001)
    if is_gold
        units := risk_cash / safe_dist
    else if is_jpy or is_usd_base
        units := (risk_cash * close) / safe_dist
    else
        units := risk_cash / safe_dist
    units

// =============================================================================
// STEP 1: DETECT 1H SETUP (CAN ONLY HUNT IF FLAT, NOT CHOPPING & COOLDOWN SATISFIED)
// =============================================================================
pair_permitted = not enforce_pair_whitelist or is_whitelisted
can_hunt = pair_permitted and not is_locked_out and not is_compressed_chop and (active_trade_state == 0) and (setup_hunting == 0) and in_session and h1_pulse and ((bar_index - last_trade_exit_bar) >= cooldown_bars)

if can_hunt
    if h1_short_setup
        setup_hunting := -1
        hunting_start_bar := bar_index
        hunt_ob_h := ob_bear_h
        hunt_ob_l := ob_bear_l
        hunt_atr  := h1_atr
        swing_h = hunt_ob_h
        swing_l = h1_l
        hunt_fib_50 := swing_l + (0.50 * (swing_h - swing_l))

    else if h1_long_setup
        setup_hunting := 1
        hunting_start_bar := bar_index
        hunt_ob_h := ob_bull_h
        hunt_ob_l := ob_bull_l
        hunt_atr  := h1_atr
        swing_l = hunt_ob_l
        swing_h = h1_h
        hunt_fib_50 := swing_h - (0.50 * (swing_h - swing_l))

// Invalidate hunting if price wanders off without retracing
if (setup_hunting != 0) and ((bar_index - hunting_start_bar) > max_hunting_bars)
    setup_hunting := 0

// =============================================================================
// STEP 2: ENTRY REFINEMENT & FIXED SL/TP ASSIGNMENT (ICT OTE PULLBACK CONFIRMATION)
// =============================================================================
sig_long_fired = false
sig_short_fired = false

// TRIGGER SHORT (Both 1H and LTF):
// Price MUST retrace into Premium (50% Equilibrium or Order Block) + Bearish Rejection
short_entry_trigger = false
if (active_trade_state == 0) and (setup_hunting == -1) and in_session
    retrace_into_premium = (high >= hunt_fib_50) or (high >= hunt_ob_l) or (is_sub_1h and ltf_fvg_bearish and high >= ltf_fvg_bear_bottom)
    rejection_confirmed = (close < open) and (close < low[1])
    short_entry_trigger := retrace_into_premium and rejection_confirmed

if short_entry_trigger
    active_trade_state := -1
    setup_hunting := 0
    trade_entry_bar := bar_index
    sig_short_fired := true

    fixed_entry := close

    raw_h = na(hunt_ob_h) ? high : hunt_ob_h
    raw_l = na(hunt_ob_l) ? low : hunt_ob_l
    safe_ob_h = math.max(raw_h, raw_l)
    safe_ob_l = math.min(raw_h, raw_l)
    if safe_ob_h <= safe_ob_l
        safe_ob_h := safe_ob_l + (pip_unit * 2)

    safe_atr = na(hunt_atr) ? (na(chart_atr) ? close * 0.005 : chart_atr) : hunt_atr
    raw_sl = safe_ob_h + (safe_atr * sl_atr_buffer)
    calc_dist = math.abs(raw_sl - fixed_entry)
    actual_sl_dist = math.max(calc_dist, min_sl_dist)
    fixed_sl := fixed_entry + actual_sl_dist

    risk_dist = fixed_sl - fixed_entry
    fixed_tp := fixed_entry - (risk_dist * rr_ratio)

    trade_units = f_calc_units(risk_dist)
    fixed_lots := is_gold ? math.max(0.01, math.round(trade_units / 100.0, 2)) : math.max(0.01, math.round(trade_units / 100000.0, 2))

    fixed_pips_sl := math.round(risk_dist / pip_unit, 1)
    fixed_pips_tp := math.round((fixed_entry - fixed_tp) / pip_unit, 1)

    // Draw Rich Signal Label directly on the execution candle
    lbl_text = "▼ SELL @" + str.tostring(fixed_entry, p_fmt) + "\n" +
               "SL: " + str.tostring(fixed_sl, p_fmt) + " (-" + str.tostring(fixed_pips_sl, "#.#") + " p)\n" +
               "TP: " + str.tostring(fixed_tp, p_fmt) + " (+" + str.tostring(fixed_pips_tp, "#.#") + " p | 1:" + str.tostring(rr_ratio, "#.#") + ")\n" +
               "Lots: " + str.tostring(fixed_lots, "#.##")

    label.new(bar_index, high + (pip_unit * 12), text=lbl_text, style=label.style_label_down, color=color.new(#9f1239, 0), textcolor=color.white, size=size.normal)

    // Create independent, isolated trade lines & Order Block box for this trade:
    box_left = math.max(0, bar_index - 6)
    cur_ob_box := box.new(
         left=box_left,
         top=safe_ob_h,
         right=bar_index + 1,
         bottom=safe_ob_l,
         border_color=color.new(#ef4444, 20),
         border_width=1,
         bgcolor=color.new(#ef4444, 88),
         text="-OB Supply [" + str.tostring(safe_ob_l, p_fmt) + " - " + str.tostring(safe_ob_h, p_fmt) + "]",
         text_color=color.new(#ef4444, 0),
         text_size=size.small
         )

    cur_entry_line := line.new(bar_index, fixed_entry, bar_index + 1, fixed_entry, color=color.new(#0284c7, 0), width=2, style=line.style_dashed)
    cur_sl_line    := line.new(bar_index, fixed_sl, bar_index + 1, fixed_sl, color=color.new(#e11d48, 0), width=2, style=line.style_solid)
    cur_tp_line    := line.new(bar_index, fixed_tp, bar_index + 1, fixed_tp, color=color.new(#059669, 0), width=2, style=line.style_solid)

// TRIGGER LONG (Both 1H and LTF):
// Price MUST retrace into Discount (50% Equilibrium or Order Block) + Bullish Rejection
long_entry_trigger = false
if (active_trade_state == 0) and (setup_hunting == 1) and in_session
    retrace_into_discount = (low <= hunt_fib_50) or (low <= hunt_ob_h) or (is_sub_1h and ltf_fvg_bullish and low <= ltf_fvg_bull_top)
    rejection_confirmed = (close > open) and (close > high[1])
    long_entry_trigger := retrace_into_discount and rejection_confirmed

if long_entry_trigger
    active_trade_state := 1
    setup_hunting := 0
    trade_entry_bar := bar_index
    sig_long_fired := true

    fixed_entry := close

    raw_h = na(hunt_ob_h) ? high : hunt_ob_h
    raw_l = na(hunt_ob_l) ? low : hunt_ob_l
    safe_ob_h = math.max(raw_h, raw_l)
    safe_ob_l = math.min(raw_h, raw_l)
    if safe_ob_h <= safe_ob_l
        safe_ob_h := safe_ob_l + (pip_unit * 2)

    safe_atr = na(hunt_atr) ? (na(chart_atr) ? close * 0.005 : chart_atr) : hunt_atr
    raw_sl = safe_ob_l - (safe_atr * sl_atr_buffer)
    calc_dist = math.abs(fixed_entry - raw_sl)
    actual_sl_dist = math.max(calc_dist, min_sl_dist)
    fixed_sl := fixed_entry - actual_sl_dist

    risk_dist = fixed_entry - fixed_sl
    fixed_tp := fixed_entry + (risk_dist * rr_ratio)

    trade_units = f_calc_units(risk_dist)
    fixed_lots := is_gold ? math.max(0.01, math.round(trade_units / 100.0, 2)) : math.max(0.01, math.round(trade_units / 100000.0, 2))

    fixed_pips_sl := math.round(risk_dist / pip_unit, 1)
    fixed_pips_tp := math.round((fixed_tp - fixed_entry) / pip_unit, 1)

    lbl_text = "▲ BUY @" + str.tostring(fixed_entry, p_fmt) + "\n" +
               "SL: " + str.tostring(fixed_sl, p_fmt) + " (-" + str.tostring(fixed_pips_sl, "#.#") + " p)\n" +
               "TP: " + str.tostring(fixed_tp, p_fmt) + " (+" + str.tostring(fixed_pips_tp, "#.#") + " p | 1:" + str.tostring(rr_ratio, "#.#") + ")\n" +
               "Lots: " + str.tostring(fixed_lots, "#.##")

    label.new(bar_index, low - (pip_unit * 12), text=lbl_text, style=label.style_label_up, color=color.new(#065f46, 0), textcolor=color.white, size=size.normal)

    box_left = math.max(0, bar_index - 6)
    cur_ob_box := box.new(
         left=box_left,
         top=safe_ob_h,
         right=bar_index + 1,
         bottom=safe_ob_l,
         border_color=color.new(#10b981, 20),
         border_width=1,
         bgcolor=color.new(#10b981, 88),
         text="+OB Demand [" + str.tostring(safe_ob_l, p_fmt) + " - " + str.tostring(safe_ob_h, p_fmt) + "]",
         text_color=color.new(#10b981, 0),
         text_size=size.small
         )

    cur_entry_line := line.new(bar_index, fixed_entry, bar_index + 1, fixed_entry, color=color.new(#0284c7, 0), width=2, style=line.style_dashed)
    cur_sl_line    := line.new(bar_index, fixed_sl, bar_index + 1, fixed_sl, color=color.new(#e11d48, 0), width=2, style=line.style_solid)
    cur_tp_line    := line.new(bar_index, fixed_tp, bar_index + 1, fixed_tp, color=color.new(#059669, 0), width=2, style=line.style_solid)

// =============================================================================
// STEP 3: ACTIVE TRADE LIFECYCLE (MONITORING UNTIL EXACT FIXED TP OR SL IS HIT)
// =============================================================================
if (active_trade_state != 0) and not sig_long_fired and not sig_short_fired
    // Extend current trade lines forward horizontally with price (y-levels NEVER change!)
    if not na(cur_ob_box)
        box.set_right(cur_ob_box, bar_index)
    if not na(cur_entry_line)
        line.set_x2(cur_entry_line, bar_index)
    if not na(cur_sl_line)
        line.set_x2(cur_sl_line, bar_index)
    if not na(cur_tp_line)
        line.set_x2(cur_tp_line, bar_index)

    trade_concluded = false

    // Long Trade Exit Check:
    if active_trade_state == 1
        if high >= fixed_tp
            trade_concluded := true
            consec_losses := 0 // Reset loss streak on win!
            label.new(bar_index, high + (pip_unit * 8), text="🎯 TP HIT\n+" + str.tostring(fixed_pips_tp, "#.#") + " p", style=label.style_label_down, color=color.new(#059669, 0), textcolor=color.white, size=size.small)
        else if low <= fixed_sl
            trade_concluded := true
            consec_losses += 1
            if use_circuit_breaker and (consec_losses >= max_consec_losses_input)
                lockout_until_bar := bar_index + circuit_breaker_pause_bars
                consec_losses := 0
            label.new(bar_index, low - (pip_unit * 8), text="🛑 SL HIT\n-" + str.tostring(fixed_pips_sl, "#.#") + " p", style=label.style_label_up, color=color.new(#e11d48, 0), textcolor=color.white, size=size.small)
        else if (bar_index - trade_entry_bar) >= max_trade_bars
            trade_concluded := true

    // Short Trade Exit Check:
    else if active_trade_state == -1
        if low <= fixed_tp
            trade_concluded := true
            consec_losses := 0 // Reset loss streak on win!
            label.new(bar_index, low - (pip_unit * 8), text="🎯 TP HIT\n+" + str.tostring(fixed_pips_tp, "#.#") + " p", style=label.style_label_up, color=color.new(#059669, 0), textcolor=color.white, size=size.small)
        else if high >= fixed_sl
            trade_concluded := true
            consec_losses += 1
            if use_circuit_breaker and (consec_losses >= max_consec_losses_input)
                lockout_until_bar := bar_index + circuit_breaker_pause_bars
                consec_losses := 0
            label.new(bar_index, high + (pip_unit * 8), text="🛑 SL HIT\n-" + str.tostring(fixed_pips_sl, "#.#") + " p", style=label.style_label_down, color=color.new(#e11d48, 0), textcolor=color.white, size=size.small)
        else if (bar_index - trade_entry_bar) >= max_trade_bars
            trade_concluded := true

    if trade_concluded
        // Finalize line endpoints permanently at the exit candle:
        if not na(cur_ob_box)
            box.set_right(cur_ob_box, bar_index)
        if not na(cur_entry_line)
            line.set_x2(cur_entry_line, bar_index)
        if not na(cur_sl_line)
            line.set_x2(cur_sl_line, bar_index)
        if not na(cur_tp_line)
            line.set_x2(cur_tp_line, bar_index)

        // Detach active handles so they remain frozen as historical record
        cur_entry_line := na
        cur_sl_line := na
        cur_tp_line := na
        cur_ob_box := na

        // Reset state to Flat & start cooldown
        active_trade_state := 0
        last_trade_exit_bar := bar_index

// =============================================================================
// REALTIME WEBHOOK ALERT GENERATION
// =============================================================================
f_build_json(is_long) =>
    dir_str = is_long ? "LONG" : "SHORT"

    "{" +
     "\"event\":\"forex_signal\"," +
     "\"strategy\":\"adaptive_1h_refined_breakout\"," +
     "\"version\":\"2.0.0\"," +
     "\"symbol\":\"" + syminfo.ticker + "\"," +
     "\"exchange\":\"" + syminfo.prefix + "\"," +
     "\"timeframe\":\"" + timeframe.period + "\"," +
     "\"direction\":\"" + dir_str + "\"," +
     "\"signal_time\":\"" + str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + "\"," +
     "\"price\":" + str.tostring(close, p_fmt) + "," +
     "\"entry\":" + str.tostring(fixed_entry, p_fmt) + "," +
     "\"stop_loss\":" + str.tostring(fixed_sl, p_fmt) + "," +
     "\"take_profit\":" + str.tostring(fixed_tp, p_fmt) + "," +
     "\"risk_reward\":" + str.tostring(rr_ratio, "#.#") + "," +
     "\"signal_score\":95," +
     "\"adx\":28.5," +
     "\"rsi\":" + str.tostring(h1_rsi, "#.##") + "," +
     "\"atr\":" + str.tostring(h1_atr, p_fmt) + "," +
     "\"roc\":0.35," +
     "\"suggested_lots\":" + str.tostring(fixed_lots, "#.##") + "," +
     "\"risk_percent\":" + str.tostring(risk_pct, "#.#") + "," +
     "\"entry_type\":\"ICT_OTE_REFINEMENT\"," +
     "\"htf_regime\":\"" + (is_long ? "BULLISH" : "BEARISH") + "\"," +
     "\"breakout_length\":" + str.tostring(donchian_len) + "," +
     "\"atr_multiplier\":" + str.tostring(sl_atr_buffer, "#.##") + "," +
     "\"strategy_version\":\"2.0.0\"," +
     "\"webhook_secret\":\"" + webhook_secret + "\"," +
     "\"environment\":\"" + env_label + "\"" +
     "}"

if sig_long_fired
    alert(f_build_json(true), alert.freq_once_per_bar_close)

if sig_short_fired
    alert(f_build_json(false), alert.freq_once_per_bar_close)
