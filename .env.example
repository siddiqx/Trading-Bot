# Server Configuration
PROJECT_NAME="Forex Live Signal Bot"
VERSION="1.0.0"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=false

# Security
WEBHOOK_SECRET="replace-with-a-strong-random-secret-key-min-16-chars"

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Database Configuration
DATABASE_URL="sqlite:///./forex_signals.db"

# Strategy Parameters & Filtering Defaults
STRATEGY_VERSION="1.0.0"
DEFAULT_ADX_MIN=18.0
DEFAULT_ADX_STRONG=25.0
DEFAULT_ROC_LOOKBACK=20
DEFAULT_DONCHIAN_LENGTH=20
DEFAULT_ATR_PERIOD=14
DEFAULT_ATR_MULTIPLIER=1.75
DEFAULT_RISK_REWARD=2.0
MIN_SIGNAL_SCORE=60.0

# Session Filter (true / false)
SESSION_FILTER_ENABLED=false
# Allowed sessions: "LONDON,NEW_YORK,OVERLAP,ASIA"
ALLOWED_SESSIONS="LONDON,NEW_YORK,OVERLAP"

# News Filter (true / false - default false until reliable calendar API attached)
NEWS_FILTER_ENABLED=false
