# ==============================================================================
# Institutional Algorithmic Trading Bot & Prop Firm Execution Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env for local running: cp .env.example .env
# 2. For 24/7 GitHub Actions execution, copy these keys into your GitHub repo:
#    GitHub Repo -> Settings -> Secrets and variables -> Actions -> New secret
# ==============================================================================

# --- 1. TELEGRAM COCKPIT & NOTIFICATION DISPATCH ---
# Telegram Bot API token obtained from @BotFather (Personal Trading Bot - Columbina Raiden)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Marketing & Social Media Content Bot Token (@contents7_bot)
# Handles ready-to-post Twitter threads, Reddit posts, TradingView packs, and bump reminders
TELEGRAM_MARKETING_BOT_TOKEN=your_marketing_bot_token_here

# Telegram numeric Chat ID for direct private alerts (e.g. 8142877259)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# --- 2. PROP FIRM RISK MANAGEMENT & POSITION SIZING ---
# Exact current account equity in USD (e.g. 5000.0, 10000.0, 25000.0, 50000.0, 100000.0)
ACCOUNT_EQUITY=5000.0

# Monetary risk percentage per trade (0.75% prop firm calibrated risk; 0.50% ultra-conservative)
# 0.75% on $10k = $75.00 risk budget per trade
# 0.75% on $25k = $187.50 risk budget per trade
RISK_PCT=0.75


# --- 3. CTRADER OPEN API AUTOMATED BROKER EXECUTION ---
# Set to 'true' to execute real trades on your cTrader broker.
# Set to 'false' (or leave unset) to run safely in simulated Paper / Dry-Run mode.
ENABLE_CTRADER_EXECUTION=false

# Environment: 'demo' for challenge / evaluation accounts; 'live' for funded accounts
CTRADER_ENV=demo

# cTrader Open API Application Credentials (from https://openapi.ctrader.com/apps/)
CTRADER_CLIENT_ID=your_client_id_here
CTRADER_CLIENT_SECRET=your_client_secret_here

# User Access Token (generated via OAuth flow or cTrader Open API Playground)
CTRADER_ACCESS_TOKEN=your_access_token_here

# cTrader Trading Account ID (ctidTraderAccountId, visible in cTrader top left)
CTRADER_ACCOUNT_ID=your_numeric_account_id_here

# Multi-Account Auto-Discovery & Concurrent Trading:
# Set to 'auto' to automatically discover and execute across all FULL_ACCESS accounts authorized on your token!
# Or supply comma-separated IDs: CTRADER_ACCOUNT_IDS=49700506, 12345678
CTRADER_ACCOUNT_IDS=auto

# Optional: Broker Symbol ID Overrides (JSON string, only if your broker uses non-standard IDs)
# Default Spotware/FTMO: {"EURUSD": 1, "GBPUSD": 2, "USDJPY": 4, "AUDUSD": 5, "USDCHF": 6, "USDCAD": 8, "XAUUSD": 41}
# CTRADER_SYMBOL_MAP={"EURUSD": 1, "GBPUSD": 2, "AUDUSD": 5, "USDCHF": 6, "USDCAD": 8, "XAUUSD": 41}


# --- 4. STEALTH ANTI-BAN & COPY-TRADING PROTECTION ---
# Optional order comment. Leave empty to submit clean orders with zero tags (looks like manual trading).
# You can also set a custom discretionary name like "swing_manual" or "tech_level".
CTRADER_ORDER_COMMENT=

# Optional order label
CTRADER_ORDER_LABEL=


# --- 5. CLOUDFLARE WORKER & GITHUB ACTIONS ORCHESTRATION ---
# GitHub Personal Access Token with repo/workflow scope (for Cloudflare Worker -> GitHub trigger)
GITHUB_TOKEN=your_github_personal_access_token_here


# --- 6. SECONDARY FASTAPI WEBHOOK CONFIGURATION (LEGACY) ---
WEBHOOK_SECRET=your_webhook_shared_secret_here
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DEBUG=False
DATABASE_URL=sqlite:///./forex_signals.db
STRATEGY_VERSION=3.3.0

# --- 7. COMMERCIAL MONETIZATION & TELEGRAM CHANNELS ---
# Public Channel username or numeric ID (QuantFlow Institutional FX)
TELEGRAM_PUBLIC_CHAT_ID=@ccrs_forex_signals

# Private VIP Channel ID (QuantFlow VIP Club)
TELEGRAM_VIP_CHAT_ID=-1005701371238

# Official Whop VIP Checkout Link
TELEGRAM_VIP_INVITE_LINK=https://whop.com/checkout/plan_AD4vSV9Uz7vyR
