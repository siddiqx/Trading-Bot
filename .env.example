# ==============================================================================
# Institutional Algorithmic Forex Trading Bot & Journal Configuration Template
# ==============================================================================
# NOTE: Copy this file to .env and fill in your actual credentials.
# NEVER commit .env or paste plaintext secrets into repository files or commits.
# ==============================================================================

# --- Telegram Cockpit & Notification Dispatch ---
# Telegram bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram numeric Chat ID or channel ID for signal delivery
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Quantitative Risk Management & Position Sizing ---
# Account equity base for risk calculations in USD (e.g., 5000.0 for $5k challenge)
ACCOUNT_EQUITY=5000.0

# Monetary risk percentage per trade (e.g., 1.0 for 1.0% risk = $50.00 on $5,000 equity)
RISK_PCT=1.0

# --- Cloudflare Edge Worker & GitHub Actions Orchestration ---
# GitHub Personal Access Token with repo / workflow scope (for Cloudflare Worker dispatches)
GITHUB_TOKEN=your_github_personal_access_token_here

# --- Secondary FastAPI Webhook Service Configuration ---
WEBHOOK_SECRET=your_webhook_shared_secret_here
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=False
DATABASE_URL=sqlite:///./forex_signals.db
STRATEGY_VERSION=2.0.0
